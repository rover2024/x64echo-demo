+//===- AArch64EchoCallLowering.cpp - Echo ABI call lowering (AArch64) ------===//
+//
+// Part of the LLVM Project (x64echo).
+//
+//===----------------------------------------------------------------------===//
+//
+// Thin AArch64 entry point for the shared Echo ABI call-lowering pass. All the
+// logic lives in EchoCallLoweringImpl.h (target-independent); this file only
+// supplies the pass boilerplate. Only the native (host) half is emitted here — the
+// face is always x86, so EmitFace is false. See x64echo docs on the arm64 native.
+//
+//===----------------------------------------------------------------------===//
+
+#include "AArch64.h"
+#include "../EchoCallLoweringImpl.h"
+#include "llvm/Pass.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "aarch64-echo-call-lowering"
+
+namespace {
+class AArch64EchoCallLowering : public ModulePass {
+public:
+  static char ID;
+  AArch64EchoCallLowering() : ModulePass(ID) {}
+  bool runOnModule(Module &M) override {
+    return echoRunOnModule(M, /*EmitFace=*/false);
+  }
+  StringRef getPassName() const override { return "AArch64 Echo call lowering"; }
+};
+} // end anonymous namespace
+
+char AArch64EchoCallLowering::ID = 0;
+
+INITIALIZE_PASS(AArch64EchoCallLowering, DEBUG_TYPE, "AArch64 Echo call lowering",
+                false, false)
+
+ModulePass *llvm::createAArch64EchoCallLoweringPass() {
+  return new AArch64EchoCallLowering();
+}
