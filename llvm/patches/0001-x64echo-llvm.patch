+static constexpr uint64_t EchoStatusOff = 32;
+static constexpr uint64_t EchoEptrOff = 48;
+static constexpr uint64_t EchoStatusPending = 2;
+static constexpr uint64_t EchoExceptionSize = 288;
+
+// EchoCallBlock varargs@56 (03-varargs). For a variadic call the face hangs the
+// boxed variadic tail (CVargEntry[], via the registered capture) here and the
+// named-arg struct on argblock; the native thunk feeds both to the registered
+// replay. CVargEntry = { i32 type; <pad>; union value } — 16 bytes, value@8.
+static constexpr uint64_t EchoVarargsOff = 56;
+static constexpr uint64_t EchoCVargSize = 16;
+static constexpr uint64_t EchoCVargValueOff = 8;
+static constexpr uint64_t EchoVargMax = 64; // ECHO_VARG_MAX (VarArgs.h)
+
+// Self-identifying stub (docs/21): symbol = stub start; instr[0..7] = jmp *[rip+2]
+// -> pack_target@8; native_target@16 (handshake-filled); magic@24. ECHO_MAGIC lets
+// the host __echo_check_call recognize one of our stubs by fixed offset.
+static constexpr uint64_t EchoStubMagic = 0xECC0DE5731B0FECEULL;
+
+static bool runNative(Module &M); // B-1: emit entry thunks
+static bool runFace(Module &M);   // B-2: emit face stubs + bindings
+
+// Any fixed-size first-class type can ride the argblock by copying its bytes:
+// scalars/pointers, and — as of the full-argument step — coerced small aggregates
+// (e.g. {i64,i64}, {double,double}) carried by value, plus byval aggregates of
+// any size carried inline. Only scalable vectors (no static size) are excluded.
+static bool isMarshalable(Type *T) {
+  if (T->isVoidTy())
+    return true;
+  return T->isSized() && !isa<ScalableVectorType>(T);
+}
+
+// One argument's placement in the flat argblock. A byval(T) parameter carries the
+// pointed-to aggregate inline (ByvalTy != null, Size = allocsize(T)); every other
+// parameter carries its value directly (Size = allocsize(paramType)).
+struct EchoSlotInfo {
+  uint64_t Off;
+  uint64_t Size;
+  Type *ByvalTy;
+};
+
+// Lay out F's arguments in the argblock: each at an offset aligned to its ABI
+// alignment (clamped to [8,16]). face and native compute this identically from
+// the same F, so the slots line up. Returns the total argblock size.
+static uint64_t echoArgLayout(const Function &F, const DataLayout &DL,
+                              SmallVectorImpl<EchoSlotInfo> &Slots) {
+  uint64_t Off = 0;
+  for (const Argument &A : F.args()) {
+    Type *BV = A.hasByValAttr() ? A.getParamByValType() : nullptr;
+    Type *T = BV ? BV : A.getType();
+    uint64_t Sz = DL.getTypeAllocSize(T);
+    uint64_t Al = std::min<uint64_t>(
+        std::max<uint64_t>(DL.getABITypeAlign(T).value(), 8), 16);
+    Off = alignTo(Off, Al);
+    Slots.push_back({Off, Sz, BV});
+    Off += Sz;
+  }
+  return alignTo(Off, 8);
+}
+
+// Same layout, computed from a bare (FunctionType, AttributeList) pair instead of a
+// Function -- used by the reentry dispatcher/redispatcher, which carry a signature +
+// its callee attrs rather than a defined function. AL is the callee's own attrs (NOT
+// shifted), so AL.getParamAttrs(I) matches FT->getParamType(I). Must stay bit-for-bit
+// identical to the Function overload so a byval aggregate rides the reentry argblock
+// exactly as it does the leaf argblock (data inline, not a cross-world pointer).
+static uint64_t echoArgLayout(FunctionType *FT, const AttributeList &AL,
+                              const DataLayout &DL,
+                              SmallVectorImpl<EchoSlotInfo> &Slots) {
+  uint64_t Off = 0;
+  for (unsigned I = 0, N = FT->getNumParams(); I < N; ++I) {
+    AttributeSet PA = AL.getParamAttrs(I);
+    Type *BV = PA.hasAttribute(Attribute::ByVal) ? PA.getByValType() : nullptr;
+    Type *T = BV ? BV : FT->getParamType(I);
+    uint64_t Sz = DL.getTypeAllocSize(T);
+    uint64_t Al = std::min<uint64_t>(
+        std::max<uint64_t>(DL.getABITypeAlign(T).value(), 8), 16);
+    Off = alignTo(Off, Al);
+    Slots.push_back({Off, Sz, BV});
+    Off += Sz;
+  }
+  return alignTo(Off, 8);
+}
+
+// STRUCTURAL: does F's signature carry a va_list at all? The va_list type is arch-
+// specific (x86 __va_list_tag* mangles P13__va_list_tag; aarch64 std::__va_list mangles
+// St9__va_list; riscv64's is a plain void* and mangles Pv, which is why the name test
+// alone cannot see it there), so a C++ va_list shows in the mangled name; an extern "C"
+// one does not,
+// so clang tags it "echo-valist" from the AST (CodeGenModule) -- the face (x86) and
+// native (arm64) compiles tag the same functions, so the two halves agree. This is the
+// "is there a va_list here" test used to locate the format argument; the ROUTING test
+// (whether to run the capture/replay machinery) is isVaListFn, below echoPrintfFamily.
+static bool isVaListParam(const Function &F) {
+  return F.getName().contains("__va_list") || F.hasFnAttribute("echo-valist");
+}
+
+// Cross-world identity for the publish handshake (echoVersionHash + the worklist
+// sort key). Canonicalise the arch-specific va_list mangling so the face (x86) and
+// native (other-arch) halves agree on this function's identity; a no-op for every
+// name without a va_list.
+//
+// The two spellings that are self-identifying (x86's P13__va_list_tag, AArch64's
+// St9__va_list) are rewritten wherever they appear. RISC-V is the awkward one: its
+// __builtin_va_list is a plain void*, so a C++ va_list parameter mangles as "Pv" --
+// indistinguishable from any other void* argument. Rewriting every "Pv" would
+// wreck unrelated names, so that case is gated on the front-end's "echo-valist"
+// tag (which both halves set from the AST, so they agree) and applied only to the
+// TRAILING Pv. A va_list is the last parameter in every function shaped like this
+// -- that is what makes it callable at all -- so the trailing one is the right one;
+// a va_list in the middle of a RISC-V signature would not be canonicalised, which
+// is a limitation worth knowing rather than a silent wrong answer, because then
+// neither half rewrites and the mismatch is with x86, not between RISC-V builds.
+static std::string echoNeutralName(const Function &F) {
+  std::string N = F.getName().str();
+  for (StringRef Va : {"P13__va_list_tag", "St9__va_list"}) {
+    size_t P;
+    while ((P = N.find(Va.str())) != std::string::npos)
+      N.replace(P, Va.size(), "9__va_listX"); // fixed neutral token, both arches
+  }
+  if (F.hasFnAttribute("echo-valist") && N.size() > 2 &&
+      N.compare(N.size() - 2, 2, "Pv") == 0 &&
+      N.find("9__va_listX") == std::string::npos)
+    N.replace(N.size() - 2, 2, "9__va_listX");
+  return N;
+}
+
+// A printf/scanf-shaped va_list function (vsnprintf, vasprintf, ...) that Echo can
+// auto-adapt without a registered ECHO_VAOPS: identified lorelei LibCFormat-style
+// by the family name plus a char* (any pointer, opaque here) format argument right
+// before the trailing va_list. Returns the 0-based format-argument index (also the
+// fixed-argument count, since the va_list is the last parameter) and the style.
+struct EchoVaFmt {
+  bool Match = false;
+  int Style = 0; // 0 = printf (ECHO_VARG_PRINTF), 1 = scanf
+  unsigned FmtIdx = 0;
+};
+static EchoVaFmt echoPrintfFamily(const Function &F) {
+  EchoVaFmt R;
+  unsigned N = F.arg_size();
+  // The format string is the pointer argument right before the variadic tail: the
+  // trailing va_list for a va_list function, or the last fixed arg for a `...` one.
+  if (isVaListParam(F)) {
+    if (N < 2 || !F.getArg(N - 2)->getType()->isPointerTy())
+      return R;
+    R.FmtIdx = N - 2;
+  } else if (F.isVarArg()) {
+    if (N < 1 || !F.getArg(N - 1)->getType()->isPointerTy())
+      return R;
+    R.FmtIdx = N - 1;
+  } else {
+    return R;
+  }
+  // The GNU format(printf/scanf) attribute (propagated into IR by clang CodeGen as
+  // "echo-format") is authoritative: it catches printf-SHAPED functions that are not
+  // printf-NAMED (QTest::addRow, SDL_Log, ...). Fall back to the name heuristic for
+  // functions without the annotation (glibc printf/vprintf, user printf-named).
+  if (F.hasFnAttribute("echo-format")) {
+    R.Style = F.getFnAttribute("echo-format").getValueAsString() == "scanf" ? 1 : 0;
+    R.Match = true;
+    return R;
+  }
+  StringRef Name = F.getName();
+  if (Name.contains("scanf"))
+    R.Style = 1;
+  else if (Name.contains("printf"))
+    R.Style = 0;
+  else
+    return R;
+  R.Match = true;
+  return R;
+}
+
+// ROUTING: should F go through the va_list capture/replay machinery (vs a normal call)?
+// A C++ va_list (mangled name token) always does -- unchanged. An extern "C" va_list is
+// visible only via the AST tag "echo-valist"; route it here ONLY when it is printf-family
+// (replayable from the format string). A non-printf extern "C" va_list -- e.g. a
+// forwarder like gfmt's apply_format(Formatter*, const char*, va_list) that hands its
+// va_list straight to a host->guest reentry and never consumes it -- keeps the plain-
+// pointer marshal it had before the tag existed (the host never interprets the list, so
+// the pointer passes through correctly). This confines the AST tag's effect to the case
+// it fixes (extern "C" printf-family va_list cross-arch) without dragging non-replayable
+// forwarders off their working path into a spurious ECHO_VAOPS abort.
+static bool isVaListFn(const Function &F) {
+  if (F.getName().contains("__va_list"))
+    return true;
+  return F.hasFnAttribute("echo-valist") && echoPrintfFamily(F).Match;
+}
+
+// A va_list function routed through the variadic (capture/replay) path instead of
+// being marshalled as a normal call. The printf/scanf family is auto-adapted with
+// the built-in extract/replay; any other va_list function still takes this path but
+// requires a user ECHO_VAOPS (the variadic stub references it weakly and aborts if a
+// caller actually crosses without one) — better a loud failure than silently running
+// a guest-local copy or marshalling the arch-specific va_list as a raw pointer.
+// Constrained to a replay-able return (void / pointer / <=64-bit integer; aggregate/
+// FP is a later step) with no sret (the hidden-pointer return needs the x8 register
+// on aarch64, which the positional replay can't set up yet); both halves apply the
+// same test, so the publish handshake stays balanced.
+// The sret parameter index (the hidden by-value-aggregate-return pointer), or -1.
+static int echoSretArg(const Function &F) {
+  for (unsigned I = 0, E = F.arg_size(); I < E; ++I)
+    if (F.getArg(I)->hasStructRetAttr())
+      return (int)I;
+  return -1;
+}
+
+static bool shouldVaListThunk(const Function &F) {
+  if (!isVaListFn(F))
+    return false;
+  if (F.isDeclaration() || F.isIntrinsic() || !F.hasExternalLinkage())
+    return false;
+  if (F.getName().starts_with("thunk_") || F.getName().starts_with("__echo"))
+    return false;
+  // A by-value AGGREGATE return uses a hidden sret pointer at arg 0 (the IR return
+  // type is then void). The sret replay path handles it (libffi routes the caller's
+  // buffer through the sret register -- x8 on aarch64, rdi on x86 -- and F writes
+  // into it, RVO-style). sret anywhere but arg 0 is unusual; keep it excluded.
+  int Sret = echoSretArg(F);
+  if (Sret > 0)
+    return false;
+  if (Sret == 0)
+    return true; // aggregate return via the sret buffer
+  Type *Rt = F.getReturnType();
+  // Replay-able returns: void / pointer / <=64-bit integer / float / double. The
+  // CVargEntry return slot (avStart in Replay.c) already boxes Float/Double, so FP
+  // returns work once allowed here. A by-value AGGREGATE is returned via a hidden
+  // sret pointer (rejected above) and handled by the separate sret replay path.
+  return Rt->isVoidTy() || Rt->isPointerTy() || Rt->isFloatTy() ||
+         Rt->isDoubleTy() ||
+         (Rt->isIntegerTy() && Rt->getIntegerBitWidth() <= 64);
+}
+
+// CVargType tag (VarArgs.h enum) for boxing a value of IR type T into a CVargEntry.
+static int echoCVargTag(Type *T) {
+  if (T->isVoidTy())
+    return 0; // CVargType_Void
+  if (T->isPointerTy())
+    return 13; // CVargType_Pointer
+  if (T->isDoubleTy())
+    return 12; // CVargType_Double
+  if (T->isFloatTy())
+    return 11; // CVargType_Float
+  if (T->isIntegerTy()) {
+    unsigned W = T->getIntegerBitWidth();
+    return W <= 8 ? 1 : W <= 16 ? 3 : W <= 32 ? 5 : 9; // Char/Short/Int/LongLong
+  }
+  return 13; // pointer-sized fallback
+}
+
+// Box Val (of IR type T) into the CVargEntry at Slot: i32 tag at offset 0, the raw
+// value at the union offset 8 (EchoCVargValueOff).
+static void echoBoxValue(IRBuilder<> &B, Value *Slot, Value *Val, Type *T,
+                         Type *I8Ty) {
+  B.CreateStore(B.getInt32(echoCVargTag(T)), Slot);
+  B.CreateAlignedStore(Val, B.CreateGEP(I8Ty, Slot, {B.getInt64(8)}), Align(1));
+}
+
+static bool shouldThunk(const Function &F) {
+  if (F.isDeclaration() || F.isIntrinsic() || F.isVarArg())
+    return false;
+  if (!F.hasExternalLinkage())
+    return false;
+  StringRef N = F.getName();
+  if (N.starts_with("thunk_") || N.starts_with("__echo"))
+    return false;
+  // A va_list function is not marshalled as a normal call (its va_list is an
+  // arch-specific ABI object): the printf/scanf family goes through the variadic
+  // capture/replay path via shouldVaListThunk, and any other va_list function is
+  // dropped (no way to walk its list without a format string, and its mangled name
+  // is arch-dependent so the two halves could not agree on it anyway).
+  if (isVaListFn(F))
+    return false;
+  for (const Argument &A : F.args()) {
+    Type *T = A.hasByValAttr() ? A.getParamByValType() : A.getType();
+    if (!isMarshalable(T))
+      return false;
+  }
+  return true;
+}
+
+// Reference the user-registered adaptor record __echo_vaops_<name> as a WEAK
+// external. Real libraries carry internal printf-style helpers (e.g. tinyxml2's
+// XMLPrinter::Print, or Qt's qWarning family) that no caller crosses; a weak
+// reference lets them link to null instead of erroring, and echoVaopsGuard traps
+// only if one is actually invoked across the boundary.
+static Constant *echoVaopsRef(Module &M, StringRef Name, StructType *OpsTy) {
+  Constant *G = M.getOrInsertGlobal(("__echo_vaops_" + Name).str(), OpsTy);
+  if (auto *GV = dyn_cast<GlobalVariable>(G))
+    if (GV->isDeclaration() && GV->hasExternalLinkage())
+      GV->setLinkage(GlobalValue::ExternalWeakLinkage);
+  return G;
+}
+
+// If Ops (a weak vaops address) is null — no adaptor registered — abort; else
+// continue in a fresh "ok" block left as the builder's insert point.
+static void echoVaopsGuard(Module &M, IRBuilder<> &B, Value *Ops, Function *Fn,
+                           StringRef Name) {
+  LLVMContext &C = M.getContext();
+  Type *PtrTy = PointerType::getUnqual(C);
+  Value *Has =
+      B.CreateICmpNE(Ops, ConstantPointerNull::get(cast<PointerType>(PtrTy)));
+  BasicBlock *Ok = BasicBlock::Create(C, "vaops.ok", Fn);
+  BasicBlock *Miss = BasicBlock::Create(C, "vaops.missing", Fn);
+  B.CreateCondBr(Has, Ok, Miss);
+  IRBuilder<> MB(Miss);
+  // Name the function. A bare abort() here reaches the user as "uncaught target
+  // signal 6" and nothing else: no symbol, no mention of variadics, no hint that an
+  // adaptor is what is missing. The one thing the reader needs is which function to
+  // write ECHO_VAOPS for, and this is the only place that still knows it.
+  MB.CreateCall(M.getOrInsertFunction(
+                    "echo_varg_no_adaptor",
+                    FunctionType::get(Type::getVoidTy(C), {PtrTy}, false)),
+                {MB.CreateGlobalString(Name, "echo_vaops_name")});
+  MB.CreateUnreachable();
+  B.SetInsertPoint(Ok);
+}
+
+// docs/23 §3.3: a variadic exported function gets the variadic face stub + replay
+// thunk path instead. Its return must come back in rax (the replay returns rax),
+// so void/pointer/<=64-bit integer only; FP/aggregate return is a later step.
+static bool shouldVarThunk(const Function &F) {
+  if (F.isDeclaration() || F.isIntrinsic() || !F.isVarArg())
+    return false;
+  if (!F.hasExternalLinkage())
+    return false;
+  StringRef N = F.getName();
+  if (N.starts_with("thunk_") || N.starts_with("__echo"))
+    return false;
+  Type *R = F.getReturnType();
+  return R->isVoidTy() || R->isPointerTy() ||
+         (R->isIntegerTy() && R->getIntegerBitWidth() <= 64);
+}
+
+// Every function the Echo compiler turns into a face/native pair (fixed or
+// variadic). face and native build this worklist over M in the same order, so
+// echo_bind indices line up.
+static bool isEchoExport(const Function &F) {
+  return shouldThunk(F) || shouldVarThunk(F) || shouldVaListThunk(F);
+}
+
+// Is this IR name one of Echo's OWN generated/glue functions? The four prefixes are the
+// naming convention; the wrinkle is that a C++ INTERNAL-linkage function's IR name is
+// Itanium-mangled (`_ZL<len><name>...`), so a raw prefix test silently stops matching the
+// moment the same source is compiled as C++ instead of C.
+//
+// HostHooks/Callback.c is exactly that file. Every port so far compiled it as C, where the
+// trampoline is plainly `echo_once_tramp` and the guard fires. ICU's build only ever
+// compiles .cpp, so the same file arrives as `_ZL15echo_once_trampv`, the guard did NOT
+// fire, its address was canonicalised to the face stub, and glibc's pthread_once then
+// called x86 bytes on a host thread -- SIGILL at an unsymbolised guest address, right
+// after the last library's bootstrap and before a single reentry.
+//
+// So demangle just enough: strip the internal-linkage prefix and the length, then test.
+static bool echoIsGlueName(StringRef N) {
+  if (N.starts_with("_ZL")) {
+    size_t i = 3, len = 0;
+    while (i < N.size() && N[i] >= '0' && N[i] <= '9')
+      len = len * 10 + (unsigned)(N[i++] - '0');
+    if (len && i + len <= N.size())
+      N = N.substr(i, len);
+  }
+  return N.starts_with("__echo") || N.starts_with("echo_") ||
+         N.starts_with("thunk_") || N.starts_with("face_pack_");
+}
+
+// No-key-function vtable redirect: a polymorphic class with NO key function has a
+// linkonce_odr vtable, so none of its virtuals is externally-linked and isEchoExport
+// misses them; yet a guest still dispatches through them (shared_ptr control blocks
+// `_Sp_counted_*`, all-inline factories). Walk every _ZTV initializer and add its
+// referenced defined virtuals to the worklist so they get face stubs / native thunks
+// too, matching CGClass's construction-side facevt redirect.
+//
+// EXCEPTION: classes CGClass declined to redirect (host-internal polymorphic types
+// libstdc++ dispatches on directly and uninstrumented -- std::locale facets) are
+// listed by mangled-vtable name in the `echo.noredirect` named metadata. Their
+// vtables must keep their real native function pointers: stubbing a facet's virtual
+// deleting destructor makes libstdc++'s locale teardown cross to the guest from host
+// context and crash. Skip those _ZTVs so both worlds stay perfectly in sync with the
+// construction side (= known-good behavior for facets, redirect for everything else).
+static void echoCollectVtableFnsRec(Constant *C, SmallPtrSetImpl<Function *> &Seen,
+                                    SmallVectorImpl<Function *> &Out) {
+  if (!C)
+    return;
+  C = C->stripPointerCasts();
+  if (auto *F = dyn_cast<Function>(C)) {
+    StringRef N = F->getName();
+    if (!F->isDeclaration() && !F->isIntrinsic() && !N.starts_with("__cxa") &&
+        !N.starts_with("__cxxabiv") && !echoIsGlueName(N) &&
+        !N.starts_with("_ZTh") && !N.starts_with("_ZTv") && !N.starts_with("_ZTc") &&
+        Seen.insert(F).second)
+      Out.push_back(F);
+    return;
+  }
+  if (auto *A = dyn_cast<ConstantAggregate>(C))
+    for (unsigned I = 0, E = A->getNumOperands(); I < E; ++I)
+      echoCollectVtableFnsRec(A->getOperand(I), Seen, Out);
+  else if (auto *CE = dyn_cast<ConstantExpr>(C))
+    for (unsigned I = 0, E = CE->getNumOperands(); I < E; ++I)
+      echoCollectVtableFnsRec(CE->getOperand(I), Seen, Out);
+}
+static void echoCollectVtableFns(Module &M, SmallVectorImpl<Function *> &Out) {
+  StringSet<> NoRedirect;
+  if (NamedMDNode *NMD = M.getNamedMetadata("echo.noredirect"))
+    for (const MDNode *Op : NMD->operands())
+      if (Op->getNumOperands() == 1)
+        if (auto *S = dyn_cast<MDString>(Op->getOperand(0)))
+          NoRedirect.insert(S->getString());
+
+  SmallPtrSet<Function *, 32> Seen;
+  SmallVector<Function *, 16> All;
+  for (GlobalVariable &G : M.globals())
+    if (G.getName().starts_with("_ZTV") && G.hasInitializer() &&
+        !NoRedirect.count(G.getName()))
+      echoCollectVtableFnsRec(G.getInitializer(), Seen, All);
+  for (Function *F : All)
+    if (!isEchoExport(*F))
+      Out.push_back(F);
+}
+
+// Convention: a function whose address is COMPARED FOR IDENTITY must carry the
+// guest (face) address, so the comparison matches a pointer taken in the other
+// world -- Qt's QMetaObject IndexOfMethod does `&incoming == &Class::signal`, and
+// the incoming pmf the guest passed over is the face stub. Only that idiom is
+// canonicalised: an `icmp` against F directly or against ptrtoint/bitcast(F). A
+// function whose address is merely stored, passed, or CALLED stays native -- it
+// may be handed to host code (libc, libstdc++) that calls it directly and must
+// reach the native body, not a guest stub. face and native compile the same
+// source, so both sides classify the same functions and name the same slots.
+static bool echoUsedByICmp(const User *U) {
+  if (isa<ICmpInst>(U))
+    return true;
+  if (const auto *CE = dyn_cast<ConstantExpr>(U))
+    if (CE->getOpcode() == Instruction::PtrToInt ||
+        CE->getOpcode() == Instruction::BitCast)
+      for (const User *UU : CE->users())
+        if (isa<ICmpInst>(UU))
+          return true;
+  return false;
+}
+// True if F's address is taken as an INTEGER (`ptrtoint @F`) -- the Itanium
+// representation of a pointer-to-member-function's first word. Qt uses a PMF purely
+// as an identity token (connect/disconnect and QMetaMethod::fromSignal compare PMFs),
+// never as a call target -- a plain callable pointer is `ptr @F` with NO ptrtoint --
+// so canonicalising the ptrtoint to the face address is safe. This catches the cross-
+// TU case the icmp-only test misses: qbuffer.cpp forms `ptrtoint(@QIODevice::readyRead)`
+// into a PMF passed to fromSignal, while the icmp that compares it lives in a DIFFERENT
+// TU (qiodevice.cpp's IndexOfMethod). Without this the two TUs classify the same signal
+// differently -- one faceaddr, one native -- and the PMF never matches, so fromSignal
+// returns a null QMetaMethod (bisected 2026-07-16: qbuffer signalTest, IndexOfMethod
+// returns -1, readyRead-tracking count stuck at 0, readyRead never emitted).
+static bool echoUsedAsPmf(const Function &F) {
+  for (const User *U : F.users()) {
+    if (const auto *CE = dyn_cast<ConstantExpr>(U))
+      if (CE->getOpcode() == Instruction::PtrToInt)
+        return true;
+    if (isa<PtrToIntInst>(U))
+      return true;
+  }
+  return false;
+}
+// True if F's address appears (directly or through a constant-expr / aggregate) in the
+// static INITIALIZER of a global variable -- the self-referential-default idiom, e.g.
+// OpenSSL's `static CRYPTO_malloc_fn malloc_impl = CRYPTO_malloc`. That global is
+// statically relocated to F's NATIVE body (a compile-time constant cannot hold the
+// runtime face address). If F's icmp identity were canonicalized to the face address,
+// then `malloc_impl != CRYPTO_malloc` would read TRUE while malloc_impl still holds the
+// default (native), wrongly taking the "a custom allocator is installed" branch and
+// calling malloc_impl (== CRYPTO_malloc) through echo_dispatch -> back into CRYPTO_malloc
+// -> infinite recursion (stack overflow). So F must keep its native identity here, to
+// match the value the static default actually stores; both sides then agree.
+static bool echoAddrInStaticGlobalInit(const Function &F) {
+  SmallVector<const User *, 8> WL(F.user_begin(), F.user_end());
+  SmallPtrSet<const User *, 8> Seen;
+  while (!WL.empty()) {
+    const User *U = WL.pop_back_val();
+    if (!Seen.insert(U).second)
+      continue;
+    if (isa<GlobalVariable>(U))
+      return true; // F's address is baked into this global's initializer
+    if (isa<ConstantExpr>(U) || isa<ConstantAggregate>(U))
+      WL.append(U->user_begin(), U->user_end());
+  }
+  return false;
+}
+static bool isEchoSyncableVar(const GlobalVariable &G); // defined below
+
+// True if F's address is STORED AT RUN TIME into an exported, storage-synced MUTABLE
+// global. Such a global is one shared slot: the guest loads the value out of it and calls
+// it directly, so whatever lands there must be guest-invokable. A native address is not,
+// and the guest faults on the first call (libxml2's xmlMemSetup writing xmlMalloc /
+// xmlFree / xmlMemStrdup is the shape).
+//
+// Only run-time stores count, deliberately. A function address baked into the global's
+// STATIC INITIALIZER cannot carry the runtime face address -- a constant initializer has
+// no place to load a slot from -- and it is handled at commit time instead, by keeping the
+// face's own initialiser (HostRuntime/Publish.c). Classifying that case here would also
+// break the identity the static default relies on, which is exactly the recursion
+// echoAddrInStaticGlobalInit exists to avoid.
+//
+// The predicate must agree between the two passes, and it does: face and native compile
+// the same source, and both evaluate it before the face erases exported bodies.
+static bool echoAddrStoredIntoSyncedGlobal(const Function &F) {
+  for (const User *U : F.users()) {
+    const auto *SI = dyn_cast<StoreInst>(U);
+    if (!SI || SI->getValueOperand() != &F)
+      continue;
+    const auto *G =
+        dyn_cast<GlobalVariable>(SI->getPointerOperand()->stripPointerCasts());
+    if (G && !G->isConstant() && isEchoSyncableVar(*G))
+      return true;
+  }
+  return false;
+}
+
+// F's address is STORED INTO MEMORY at run time. Whatever lands in that memory can reach
+// the guest, which calls it directly with no dispatcher in the way, so the value has to be
+// the face stub. This is the general form of the synced-global case above: lcms2 hands the
+// guest a heap struct whose Interpolation field the native half filled with a native
+// function, and `p->Interpolation.Lerp16(...)` jumps into the host region and faults.
+//
+// Deliberately run-time stores only, for the same reason as the synced-global rule: a
+// static initializer cannot hold a runtime face address, and reclassifying one would break
+// the self-referential default that echoAddrInStaticGlobalInit exists to protect.
+static bool echoAddrStoredToMemory(const Function &F) {
+  for (const User *U : F.users())
+    if (const auto *SI = dyn_cast<StoreInst>(U))
+      if (SI->getValueOperand() == &F)
+        return true;
+  return false;
+}
+
+// Name of F's canonical-face-address slot. An internal function gets the module hash
+// mixed in: its name is unique only inside its own module, and the slot is published by
+// name into every loaded object, so a bare name would let one library's internal `init`
+// take another's slot.
+static uint64_t echoSourceHash(const Module &M); // defined below
+static std::string echoFaceAddrSlotName(Module &M, const Function &F) {
+  if (F.hasInternalLinkage())
+    return ("__echo_faceaddr$" + Twine::utohexstr(echoSourceHash(M)) + "$" + F.getName())
+        .str();
+  return ("__echo_faceaddr$" + F.getName()).str();
+}
+
+// Is this constant reachable only from an Echo-generated descriptor the HOST dereferences
+// directly? Those must keep native addresses.
+//
+// __echo_exc$<type> carries the thrown type's copy-constructor, and the host's
+// __echo_catch_current calls it as `d->copy(buf, obj)` with no dispatcher in between, so a
+// face address there sends host code to a guest address and kills the process. Same for
+// anything else Echo emits for its own runtime to walk.
+static bool echoInEchoOwnedDescriptor(const Constant *C, unsigned Depth = 0) {
+  if (Depth > 6)
+    return false;
+  for (const User *U : C->users()) {
+    if (const auto *GV = dyn_cast<GlobalVariable>(U)) {
+      StringRef N = GV->getName();
+      if (N.starts_with("__echo") || N.starts_with("echo_"))
+        return true;
+      continue;
+    }
+    if (const auto *CC = dyn_cast<Constant>(U))
+      if (echoInEchoOwnedDescriptor(CC, Depth + 1))
+        return true;
+  }
+  return false;
+}
+
+// A function whose address is used for cross-world IDENTITY -- compared with icmp, or
+// taken as a PMF integer. Both idioms must carry the face address so a pointer taken in
+// one world/TU matches one taken in another. face & native compile the same source, so
+// both sides classify the same functions and name the same __echo_faceaddr$F slots.
+static bool echoComparedAsValue(const Function &F) {
+  if (echoUsedAsPmf(F))
+    return true; // PMF integer identity token (Qt signals) is always the cross-world face
+  // A run-time store into a shared, guest-readable slot outranks the self-referential
+  // default below: the guest CALLS what it finds there, so the value has to be the face
+  // stub even if F's address also appears in some static initializer.
+  if (echoAddrStoredIntoSyncedGlobal(F))
+    return true;
+  // A self-referential native default (its address is a static global initializer) must
+  // compare by its NATIVE identity, so the "is a custom impl installed?" self-check
+  // matches the default and does not recurse. See echoAddrInStaticGlobalInit.
+  if (echoAddrInStaticGlobalInit(F))
+    return false;
+  // General escape into memory. Ordered AFTER the static-initializer exclusion on
+  // purpose: a function that is both a self-referential default AND stored at run time
+  // keeps its native identity, because the recursion that exclusion prevents is a hard
+  // failure while this rule is a broadening.
+  // Any use of F AS A VALUE. A function that decays to a pointer must carry the one
+  // canonical address wherever that happens -- an icmp, a ptrtoint, a store, a select
+  // between two candidates, a phi, an argument, a return. Enumerating use kinds is what
+  // let lcms2 through: it picks an interpolator with
+  //     Interpolation.Lerp16 = IsFloat ? LinLerp1Dfloat : LinLerp1D;
+  // which -O2 turns into a select, and a select was not on the list, so the native
+  // address escaped to the guest and the guest called into the host region.
+  for (const User *U : F.users()) {
+    if (const auto *CB = dyn_cast<CallBase>(U)) {
+      if (CB->getCalledOperand() == &F)
+        continue; // a direct call target stays native
+      // Passed AS AN ARGUMENT. A callee DEFINED here consumes the pointer inside this
+      // world, so the pointer has to be the face address. A callee that is only DECLARED
+      // is usually host code that will consume it host-side, and handing that a face
+      // address breaks it: pthread_create is the case -- libc's start_thread calls the
+      // thread entry directly, so a canonicalised entry jumps into the guest and dies.
+      //
+      // But "only declared" is NOT the same as "outside this world". Without LTO every
+      // cross-TU call inside the library being ported is a declaration too, and treating
+      // those as host code leaves a genuinely escaping callback native. RocksDB is the
+      // case: cachable_entry.h does
+      //     cleanable->RegisterCleanup(&CachableEntry<Block>::ReleaseCacheHandle, ...)
+      // with Cleanable::RegisterCleanup defined over in util/cleanable.cc, and the
+      // Cleanable it fills is a PinnableSlice on the GUEST's stack whose inline
+      // destructor calls that pointer with nothing in between. The guest jumped straight
+      // into aarch64 code on the first Get() that hit a cached block -- rip == the fault
+      // address, inside the native library's text.
+      //
+      // An Itanium-mangled name settles which side the callee is on: libc's entry points
+      // are extern "C", so a _Z-mangled declaration is C++ and belongs either to this
+      // library or to libstdc++ -- and libstdc++'s own entry points all live under std::,
+      // which stays excluded for the same reason std::thread::_State is.
+      const Function *Callee = CB->getCalledFunction();
+      if (Callee && Callee->isDeclaration()) {
+        StringRef CN = Callee->getName();
+        if (!CN.starts_with("_Z") || CN.starts_with("_ZSt") ||
+            CN.starts_with("_ZNSt") || CN.starts_with("_ZNKSt"))
+          continue;
+      }
+      return true;
+    }
+    if (const auto *CC = dyn_cast<Constant>(U)) {
+      if (!isa<ConstantExpr>(CC) && !isa<ConstantAggregate>(CC))
+        continue;
+      if (echoInEchoOwnedDescriptor(CC))
+        continue; // Echo's own runtime dereferences this one; keep it native
+      return true;
+    }
+    // Stored into a slot the HOST C++ runtime owns and dereferences from host context.
+    // std::call_once compiles to
+    //     std::__once_call = [] { ... };          // __once_call lives in libstdc++.so
+    //     __gthread_once(&flag, &__once_proxy);   // so does __once_proxy
+    // and libstdc++'s __once_proxy -- code Echo never compiled -- loads that slot and
+    // calls it with nothing in between. Canonicalising the lambda's __invoke to the face
+    // stub makes a host thread execute x86 bytes: SIGILL at an unsymbolised PC with an
+    // empty backtrace, in RocksDB's case on the very first Env::Default(). It is the same
+    // shape as the pthread_create carve-out just above, and as std::thread::_State in
+    // echo_noredirect.list -- and it is symmetric, because each world's call_once stores
+    // its own world's address into its own libstdc++'s slot.
+    if (const auto *SI = dyn_cast<StoreInst>(U))
+      if (SI->getValueOperand() == &F) {
+        // __once_call is thread_local, so the store's pointer operand is not the global
+        // but a call to llvm.threadlocal.address -- stripPointerCasts does not see
+        // through that, and a check written without this looks like it works and
+        // silently never fires.
+        const Value *P = SI->getPointerOperand()->stripPointerCasts();
+        if (const auto *TL = dyn_cast<IntrinsicInst>(P))
+          if (TL->getIntrinsicID() == Intrinsic::threadlocal_address)
+            P = TL->getArgOperand(0)->stripPointerCasts();
+        if (const auto *G = dyn_cast<GlobalVariable>(P))
+          if (G->getName() == "_ZSt11__once_call")
+            continue;
+      }
+    if (isa<Instruction>(U))
+      return true;
+  }
+  return false;
+}
+
+// An exported data global is duplicated in both worlds (face + native); the guest
+// is physically locked to the FACE copy (it cannot even name the native one). For a
+// CONST global (identical bytes) only its ADDRESS matters, so a cross-world identity
+// comparison (Qt's qobject_cast / QMetaObject::cast on &staticMetaObject) is fixed
+// by canonicalising the address to the face copy. A MUTABLE global is worse — a
+// STORAGE divergence: the host writes the native copy, the guest reads/writes the
+// face copy, and they drift — so every access (loads/stores too) is redirected to
+// the one canonical (face) storage. We cannot know which exported global the
+// arbitrary guest will touch, so the criterion is "exported", not how the library
+// itself uses it. Vtables (facevt) and RTTI (_ZTI/_ZTS) have their own mechanisms.
+// True if this module accesses G (through any GEP/cast chain) with an ATOMIC op.
+// Such a global is a host-internal synchronization primitive (a QBasicAtomicInt like
+// QLocalePrivate::s_generation, a Q_GLOBAL_STATIC guard); the guest never needs its
+// live value, and redirecting the host's atomic RMW onto the shared (guest-memory)
+// face copy is what corrupts real Qt (docs/07 §5). Exclude them from storage sync.
+[[maybe_unused]] static bool echoHasAtomicUse(const GlobalVariable &G) {
+  SmallVector<const User *, 16> WL(G.user_begin(), G.user_end());
+  SmallPtrSet<const User *, 16> Seen;
+  while (!WL.empty()) {
+    const User *U = WL.pop_back_val();
+    if (!Seen.insert(U).second)
+      continue;
+    if (isa<AtomicRMWInst>(U) || isa<AtomicCmpXchgInst>(U))
+      return true;
+    if (const auto *LI = dyn_cast<LoadInst>(U))
+      if (LI->isAtomic())
+        return true;
+    if (const auto *SI = dyn_cast<StoreInst>(U))
+      if (SI->isAtomic())
+        return true;
+    if (isa<GetElementPtrInst>(U) || isa<BitCastInst>(U) ||
+        isa<AddrSpaceCastInst>(U) || isa<ConstantExpr>(U))
+      WL.append(U->user_begin(), U->user_end());
+  }
+  return false;
+}
+
+// A QMetaObject `staticMetaObject` (const, struct type named ...QMetaObject...). Its
+// address is the cross-world identity token for qobject_cast / QMetaObject::inherits, so
+// it must be homed even when the CLASS is hidden or internal -- a Qt plugin compiles its
+// QObject classes with -fvisibility=hidden, so QJpegPlugin::staticMetaObject is a LOCAL
+// symbol, yet a guest `qobject_cast<QImageIOPlugin*>` on a runtime-dlopen'd plugin
+// instance must still reconcile the metaobject chain to the face copy. This mirrors the
+// type-name gate already used by isEchoSyncableConstDeclRef and the deep-home descriptor.
+static bool echoIsQMetaObjectSMO(const GlobalVariable &G) {
+  if (!G.isConstant())
+    return false;
+  auto *ST = dyn_cast<StructType>(G.getValueType());
+  return ST && ST->hasName() && ST->getName().contains("QMetaObject");
+}
+
+// Name/visibility/linkage shape common to any syncable exported global, whether it
+// is seen here as a definition or as an external declaration.
+static bool echoVarSyncShapeOK(const GlobalVariable &G) {
+  if (G.hasLocalLinkage() || !G.hasDefaultVisibility()) {
+    // A hidden/internal global normally can't be homed: the guest binds a syncable var
+    // by NAME (the __echo_var$G slot is dlsym'd, but the value the face publishes is the
+    // hidden symbol's own address, which a co-built face+native pair can still name). The
+    // ONE exception is a QMetaObject staticMetaObject: its slot is default-visible and its
+    // face copy is captured BY ADDRESS in the reverse-publish table (not dlsym'd), so a
+    // hidden plugin class's SMO homes correctly and cross-world qobject_cast reconciles.
+    if (!echoIsQMetaObjectSMO(G))
+      return false; // internal/hidden non-SMO: the guest can't bind to it
+  }
+  if (G.hasAppendingLinkage())
+    return false; // llvm.used / llvm.global_ctors / ... : link-merged specials
+  if (G.isThreadLocal())
+    return false; // TLS has per-thread storage; a shared copy would be wrong
+  StringRef N = G.getName();
+  if (N.starts_with("llvm.") || N.starts_with("__echo") ||
+      N.starts_with("echo_") || N.starts_with("_ZTV") ||
+      N.starts_with("_ZTI") || N.starts_with("_ZTS"))
+    return false;
+  return true;
+}
+
+// The MUTABLE storage-sync gate (docs/07 §5): OFF by default. ECHO_SYNC_MUTABLE=1
+// opts in; ECHO_NOSYNC_VARS (comma-separated name substrings) excludes globals per
+// bisect step with no clang rebuild. Host-internal ATOMIC primitives are always
+// excluded (a host atomic RMW on the shared, guest-memory face copy is unsafe
+// cross-ISA). Applied to both a definition and an external declaration of a mutable
+// global (the declaration sees only THIS module's uses for the atomic test, which is
+// safe: the redirect falls back to the native copy whenever the slot is null).
+static bool echoMutSyncAllowed(const GlobalVariable &G) {
+  if (!::getenv("ECHO_SYNC_MUTABLE"))
+    return false; // gate: mutable sync off unless opted in
+  if (echoHasAtomicUse(G))
+    return false;
+  // Only a SCALAR mutable global (one integer, float, or pointer slot) is byte-
+  // portable across the world boundary. An AGGREGATE (struct/array/vector) may embed
+  // a pointer into per-world-private heap state: muParser's ParserBase::s_locale is a
+  // std::locale holding a std::locale::_Impl* allocated in ONE world, so sharing its
+  // bytes hands the other world a foreign pointer and crashes at bootstrap. Integers
+  // and floats are value-portable; a pointer to a shared HOST object is carried
+  // correctly by the facevt/redirect machinery (qApp, the event dispatcher). Exclude
+  // everything else -- this is the "narrow the mutable range" refinement (docs/07 §5).
+  Type *VT = G.getValueType();
+  if (!VT->isIntegerTy() && !VT->isFloatingPointTy() && !VT->isPointerTy())
+    return false;
+  if (const char *NS = ::getenv("ECHO_NOSYNC_VARS")) {
+    SmallVector<StringRef, 8> Toks;
+    StringRef(NS).split(Toks, ',', -1, false);
+    for (StringRef T : Toks)
+      if (G.getName().contains(T))
+        return false; // bisect: exclude any name containing a token
+  }
+  return true;
+}
+
+// A global DEFINED in this module that the face publishes and the native canonicals.
+// A CONST global of any type is always safe (address-only). A MUTABLE one is behind
+// the ECHO_SYNC_MUTABLE gate.
+// True for a vtable CGClass declined to redirect (its mangled _ZTV name is recorded in
+// the `echo.noredirect` metadata; see echoCollectVtableFns). Such a vtable must keep
+// its real native function pointers in BOTH mechanisms, not just the worklist: a vtable
+// is an aggregate full of function pointers, so it matches echoIsBindingIfaceGlobal on
+// its own, and back-filling its slots with face stubs undoes the exclusion the list
+// exists for. std::thread::_State is the case that showed it -- libstdc++'s
+// execute_native_thread_routine virtual-calls _M_run() on a HOST thread from code Echo
+// never compiled; the homed slot sent it to a face stub and the thread took SIGILL on
+// the stub's first x86 byte, with an unsymbolised PC and an empty backtrace.
+static bool echoIsNoRedirectVTable(const GlobalVariable &G) {
+  if (!G.getName().starts_with("_ZTV"))
+    return false;
+  const Module *M = G.getParent();
+  if (!M)
+    return false;
+  const NamedMDNode *NMD = M->getNamedMetadata("echo.noredirect");
+  if (!NMD)
+    return false;
+  for (const MDNode *Op : NMD->operands())
+    if (Op->getNumOperands() == 1)
+      if (auto *S = dyn_cast<MDString>(Op->getOperand(0)))
+        if (S->getString() == G.getName())
+          return true;
+  return false;
+}
+
+static bool isEchoSyncableVar(const GlobalVariable &G) {
+  if (G.isDeclaration() || !G.hasInitializer())
+    return false;
+  // A library's own virtual-dispatch descriptor must NOT be address-homed either, and the
+  // reason is the mirror image of why its fields must not be: V4 decides "is this object a
+  // T?" by comparing the object's internalClass->vtable against &T::static_vtbl. Home the
+  // address and the two sides of that comparison stop agreeing -- measured, on a freshly
+  // created QQmlTypeWrapper:
+  //
+  //   object->internalClass->vtable            = 0x1b32c60      (face, via the homed slot)
+  //   object->...->vtable->className           = "QQmlTypeWrapper"   <- it IS one
+  //   &QV4::QQmlTypeWrapper::static_vtbl        = 0xffffd7e10180 (native, via the GOT)
+  //
+  // so Scoped<QQmlTypeWrapper> came back empty, initLoadAttachedLookup stored a null type
+  // wrapper next to a perfectly good getter, and every Controls Dialog and Popup died
+  // dereferencing it. The producer read the slot; the consumer read the symbol.
+  //
+  // Unlike a cross-world dispatch table there is nothing to share here: each half has its
+  // own descriptor for its own objects, and neither ever hands one to the other.
+  if (G.getName().contains("static_vtbl"))
+    return false;
+  if (echoIsNoRedirectVTable(G))
+    return false;
+  if (!echoVarSyncShapeOK(G))
+    return false;
+  if (!G.isConstant() && !echoMutSyncAllowed(G))
+    return false;
+  return true;
+}
+
+// A hand-written function-pointer table whose ADDRESS is handed to the other world:
+// QtPrivate::QBindableInterface (property getter/setter/makeBinding/... pointers) and
+// BindingFunctionVTable. Qt returns `&iface` from bindableXxx() to the guest, which then
+// calls iface->makeBinding(...) inline -- so those function fields must be guest-invokable
+// (Echo rule: "every function that decays to a pointer must be guest-invokable"). Unlike
+// a C++ vtable these are NOT redirected, and the iface global is typically LOCAL/HIDDEN
+// (template instance internalised per TU) so it can't be address-homed. Gated by struct
+// type name (like the QMetaObject deep-home gate) to bound the blast radius to Qt's
+// property-binding interfaces; a host caller of a demoted field routes via the dispatcher.
+static bool echoConstantHasFunction(const Constant *C, unsigned Depth = 0) {
+  if (!C || Depth > 6)
+    return false;
+  if (isa<Function>(C->stripPointerCasts()))
+    return true;
+  for (const Use &U : C->operands())
+    if (const auto *Op = dyn_cast<Constant>(U.get()))
+      if (echoConstantHasFunction(Op, Depth + 1))
+        return true;
+  return false;
+}
+
+static bool echoIsBindingIfaceGlobal(const GlobalVariable &G) {
+  if (!G.hasInitializer())
+    return false;
+  // Never Echo's own descriptors. __echo_exc$<type> is a const aggregate holding the
+  // thrown type's copy-constructor, which matches the generalised test below exactly --
+  // and the HOST calls that pointer directly (__echo_catch_current does d->copy(buf,obj)),
+  // so face-homing the field sends host code to a guest address.
+  StringRef GN = G.getName();
+  if (GN.starts_with("__echo") || GN.starts_with("echo_"))
+    return false;
+  // Nor the linker-collected lists LLVM reserves for itself. llvm.global_ctors is an
+  // appending array of {priority, ctor, data}, so once MUTABLE aggregates became
+  // eligible it matched -- with the module's own static-init function as the "table
+  // field" to home. Two things then go wrong: the back-fill would overwrite a ctor
+  // slot with a face stub, and this pass REBUILDS llvm.global_ctors further down and
+  // erases the old global, leaving the descriptor pointing at freed memory. That
+  // surfaced far away, as a garbage type while emitting an unrelated global.
+  if (GN.starts_with("llvm.") || G.hasAppendingLinkage())
+    return false;
+  auto *ST = dyn_cast<StructType>(G.getValueType());
+  if (ST && ST->hasName()) {
+    StringRef T = ST->getName();
+    if (T.contains("QBindableInterface") || T.contains("BindingFunctionVTable"))
+      return true;
+  }
+  // A library's OWN virtual-dispatch descriptor is not a cross-world dispatch table, and
+  // face-homing its fields is actively destructive. QV4::VTable is the case that showed
+  // it: 968 of its function fields were back-filled with face stubs, so a native
+  // `object->vtable()->resolveLookupGetter(...)` landed in a dispatcher, was classified
+  // as guest and reentered -- with native heap pointers as arguments. The engine pointer
+  // came out the other side as a face address and lookup resolution recursed until the
+  // stack was gone. Every Controls Dialog and Popup died that way.
+  //
+  // The distinguishing property is not "holds function pointers" -- a real plugin table
+  // does too. It is that the OWNING library dereferences and calls these fields itself,
+  // on objects it allocated, and that the table's ADDRESS is separately used as a type
+  // token (`as<T>()` compares vtable == &T::static_vtbl). The two worlds never share one:
+  // each half has its own copy for its own objects. Same reasoning as the __echo_exc$
+  // exclusion above.
+  if (ST && ST->hasName() && ST->getName().contains("QV4::VTable"))
+    return false;
+  if (G.getName().contains("static_vtbl"))
+    return false;
+  if (echoIsNoRedirectVTable(G))
+    return false;
+  // Any CONST aggregate holding function pointers is a dispatch table, and the guest
+  // reaches its entries through whatever the library hands back. lcms2 picks a pixel
+  // formatter out of `static const cmsFormatters16 InputFormatters16[]` and returns the
+  // struct by value, so the guest ends up calling a native address.
+  //
+  // AGGREGATE is the gate, and it is the whole gate: const has nothing to do with it.
+  // The dangerous neighbour is a MUTABLE SCALAR function pointer holding a
+  // self-referential default -- OpenSSL's `static CRYPTO_malloc_fn malloc_impl =
+  // CRYPTO_malloc;` -- where native code tests `malloc_impl != CRYPTO_malloc` to decide
+  // whether a custom allocator was installed. Homing that one makes the test read true
+  // against its own default and recurse (see echoAddrInStaticGlobalInit). Being scalar
+  // is what makes it dangerous, so excluding scalars is enough, and excluding mutable
+  // aggregates as well only hid the same bug behind a different keyword: OpenSSL's
+  // `static UI_METHOD ui_openssl = { "...", open_console, ... }` is a plain mutable
+  // struct, UI_OpenSSL() hands its address straight to the guest, and the guest read
+  // open_console's NATIVE address out of it and called it. That took out every recipe
+  // that reads a password-protected key.
+  if (!G.getValueType()->isAggregateType())
+    return false;
+  return echoConstantHasFunction(G.getInitializer());
+}
+
+// Collect the (byte offset, Function) of every function-pointer field in a binding-iface
+// initializer. No external-linkage filter (the lambda invokers are LOCAL), but skip the
+// Echo glue and declarations. Used both to worklist the functions (face stubs) and to
+// emit the face-home back-fill descriptors.
+static void echoCollectIfaceFuncFields(
+    const DataLayout &DL, const Constant *C, uint64_t Off,
+    SmallVectorImpl<std::pair<uint64_t, Function *>> &Out) {
+  if (const auto *CS = dyn_cast<ConstantStruct>(C)) {
+    const StructLayout *SL = DL.getStructLayout(CS->getType());
+    for (unsigned i = 0, e = CS->getNumOperands(); i != e; ++i)
+      echoCollectIfaceFuncFields(DL, CS->getOperand(i),
+                                 Off + SL->getElementOffset(i), Out);
+    return;
+  }
+  if (const auto *CA = dyn_cast<ConstantArray>(C)) {
+    uint64_t ES = DL.getTypeAllocSize(CA->getType()->getElementType());
+    for (unsigned i = 0, e = CA->getNumOperands(); i != e; ++i)
+      echoCollectIfaceFuncFields(DL, CA->getOperand(i), Off + i * ES, Out);
+    return;
+  }
+  const Constant *S = C->stripPointerCasts();
+  if (auto *F = dyn_cast<Function>(const_cast<Constant *>(S))) {
+    StringRef N = F->getName();
+    // A DECLARATION counts too. The table is what the guest reads, and where the callee
+    // happens to be defined says nothing about whether the guest can call it: OpenSSL's
+    // core_dispatch_[] hands the provider a mix of file-local helpers and cross-TU
+    // exports (BIO_vsnprintf lives in bio_print.c), and skipping the declarations homed
+    // half the table and left the other half pointing at native code. A guest provider
+    // then called BIO_vsnprintf's host address directly and died -- with the crash inside
+    // the provider's own snprintf helper, nowhere near the table.
+    //
+    // Requiring a definition was never the point; the Echo glue is.
+    if (!F->isIntrinsic() && !echoIsGlueName(N))
+      Out.push_back({Off, F});
+  }
+}
+
+static void echoCollectEscapingFns(Module &M, SmallVectorImpl<Function *> &Out) {
+  const DataLayout &DL = M.getDataLayout();
+  SmallPtrSet<Function *, 32> Seen(Out.begin(), Out.end()); // skip already-listed
+  for (GlobalVariable &G : M.globals()) {
+    if (!echoIsBindingIfaceGlobal(G))
+      continue;
+    SmallVector<std::pair<uint64_t, Function *>, 8> Fields;
+    echoCollectIfaceFuncFields(DL, G.getInitializer(), 0, Fields);
+    for (auto &Fld : Fields)
+      // A field that is only DECLARED here gets no stub from this TU. The collector
+      // deliberately reports declarations, because the table still has to be homed
+      // field by field and the __echo_faceaddr$F slot it is back-filled with is
+      // linkonce_odr, so any TU can name it. A thunk is not: an exported function's
+      // thunk_X carries external linkage, one strong definition for the whole program,
+      // and that definition belongs to the TU that defines the function. Emitting one
+      // here as well makes every TU holding a copy of the table define it too. OpenSSL
+      // is full of tables of ASN1_ITEM accessors, so this showed up as several hundred
+      // `duplicate symbol: thunk_ASN1_TIME_it` and no library at all.
+      if (!Fld.second->isDeclaration() && !isEchoExport(*Fld.second) &&
+          Seen.insert(Fld.second).second)
+        Out.push_back(Fld.second);
+  }
+  // A function whose address is stored into memory needs a face stub even when it is not
+  // exported. A C library's plugin table is usually filled with INTERNAL functions: lcms2
+  // sets Interpolation.Lerp16 = LinLerp1D, and LinLerp1D is hidden, so without this there
+  // is no face address to canonicalise the store to and the native address escapes to the
+  // guest anyway. Hidden visibility still means external linkage, so the name is unique
+  // within this shared object and both halves derive the same __echo_faceaddr$F.
+}
+
+// Internal functions whose address escapes. They get a face STUB, like an exported one.
+//
+// Publishing the face's own copy instead looks tempting -- a file-local function keeps a
+// real body in the face, so its address is already guest-executable -- but it is wrong.
+// That copy then RUNS in the guest, and the native data structures it walks are full of
+// native function pointers, so it faults on the first one. lcms2 shows it directly: the
+// face's FloatXFORM was reentered from native code and died calling the pipeline
+// evaluator. A stub keeps the body on the native side where its data lives, and
+// __echo_check_call short-circuits a native call through it back to the real body.
+static void echoCollectInternalEscapers(Module &M,
+                                        SmallVectorImpl<Function *> &Out) {
+  SmallPtrSet<Function *, 32> Seen(Out.begin(), Out.end());
+  for (Function &F : M) {
+    // linkonce_odr / weak_odr as well as internal. This set must match the one the
+    // address-canonicalisation loop rewrites, or the two disagree in the worst possible
+    // way: the loop emits __echo_faceaddr$F and loads from it, the face never puts F in
+    // its worklist so nothing ever publishes that slot, and the branchless fallback
+    // quietly hands the guest &F_native -- the exact failure this whole mechanism
+    // exists to prevent, with a slot sitting right there looking like it works.
+    if (F.isDeclaration() || F.isIntrinsic() ||
+        (!F.hasInternalLinkage() && !F.hasLinkOnceODRLinkage() &&
+         !F.hasWeakODRLinkage()))
+      continue;
+    if (echoIsGlueName(F.getName()))
+      continue;
+    if (echoComparedAsValue(F) && Seen.insert(&F).second)
+      Out.push_back(&F);
+  }
+}
+
+// A MUTABLE global referenced here only through an external DECLARATION. Its uses
+// must ALSO be redirected to the canonical face storage (the __echo_var$G slot), or
+// this module reads the un-synced native copy while the DEFINING module wrote the
+// face copy -- the cross-module divergence that is the ROOT CAUSE of the Qt break
+// (bisected 2026-07-13: QCoreApplication::self=qApp / eventDispatcher / is_app_running
+// / attribs are written in qcoreapplication.cpp but read via declarations elsewhere).
+// A null slot -> &G fallback keeps it correct when the definition itself wasn't synced
+// (e.g. the definition is atomic-elsewhere and never published), so redirecting a
+// superset of the published globals is safe. Const declarations are left alone (the
+// const address path is definition-local and already passes qobject_cast).
+static bool isEchoSyncableMutDeclRef(const GlobalVariable &G) {
+  if (!G.isDeclaration() || G.isConstant())
+    return false;
+  if (!G.hasExternalLinkage())
+    return false; // only a resolvable extern reference binds to the shared storage
+  if (!echoVarSyncShapeOK(G))
+    return false;
+  return echoMutSyncAllowed(G);
+}
+
+// A CONST exported global referenced here only through an external DECLARATION -- its
+// ADDRESS must ALSO be canonicalised to the face copy, or a cross-world identity test in
+// THIS module compares the un-homed native address. Qt hits this with QObject::
+// staticMetaObject: qmetaobject.cpp's QMetaObject::newInstance() does
+// `mobj->inherits(&QObject::staticMetaObject)`, but staticMetaObject is DEFINED in
+// qobject.cpp, so here it is a const extern decl -- isEchoSyncableVar (definitions only)
+// skips it and the guest SMO's superdata chain (face addresses) never matches the native
+// &staticMetaObject. Mirrors isEchoSyncableMutDeclRef, but const (address-only; the slot
+// is published by the defining module).
+// Does this type contain a pointer anywhere? A const global whose bytes hold no pointer
+// is IDENTICAL in both worlds: nothing in it was relocated per world, so the face copy and
+// the native copy are the same bytes at different addresses. Homing its address is then
+// safe to dereference from either side. A const global that DOES hold pointers is not: its
+// face copy carries face-relocated pointers, so handing that address to native code and
+// letting it dereference hands native code guest pointers.
+static bool echoTypeHasNoPointer(Type *T, unsigned Depth = 0) {
+  if (Depth > 8)
+    return false; // give up rather than guess
+  if (T->isPointerTy())
+    return false;
+  if (auto *AT = dyn_cast<ArrayType>(T))
+    return echoTypeHasNoPointer(AT->getElementType(), Depth + 1);
+  if (auto *VT = dyn_cast<VectorType>(T))
+    return echoTypeHasNoPointer(VT->getElementType(), Depth + 1);
+  if (auto *ST = dyn_cast<StructType>(T)) {
+    if (ST->isOpaque())
+      return false; // no field list to inspect
+    for (Type *F : ST->elements())
+      if (!echoTypeHasNoPointer(F, Depth + 1))
+        return false;
+    return true;
+  }
+  return T->isIntegerTy() || T->isFloatingPointTy();
+}
+
+static bool isEchoSyncableConstDeclRef(const GlobalVariable &G) {
+  if (!G.isDeclaration() || !G.hasExternalLinkage())
+    return false; // a resolvable extern binds to the shared face copy by name
+  if (!echoVarSyncShapeOK(G))
+    return false;
+  // Only a QMetaObject SMO. Its address is used for cross-world IDENTITY (inherits /
+  // qobject_cast), and it is deep-homed so its face copy's pointer fields point at the
+  // one native blob -- reading through the homed address is safe. A generic const
+  // aggregate (a date/timezone/URL lookup table) is NOT deep-homed: its face copy holds
+  // per-world-relocated pointers, so homing its address and then dereferencing it hands
+  // native code face pointers and crashes. The declaration of a const aggregate is spelled
+  // `external global` (const marker lost at the reference site), so gate by the SMO type
+  // name -- mirrors the QMetaObject gate on the deep-home descriptor emission.
+  auto *ST = dyn_cast<StructType>(G.getValueType());
+  if (ST && ST->hasName() && ST->getName().contains("QMetaObject"))
+    return true;
+  // The pointer-free case is the exact opposite of the hazard above, so it is safe for
+  // the same reason the hazard exists: with no pointers there is nothing relocated per
+  // world, and the two copies are the same bytes. libxml2 needs it. Its comment nodes
+  // carry `name = xmlStringComment`, an exported `const xmlChar[]`, and debugXML.c
+  // checks `node->name == xmlStringComment` by ADDRESS. The defining TU homes the
+  // address, the checking TU sees only `external constant [0 x i8]` and kept the native
+  // one, so the two disagreed and runtest reported "Comment node has wrong name
+  // 'comment'" -- a name that is, of course, exactly right.
+  return echoTypeHasNoPointer(G.getValueType());
+}
+
+// Address-escaping use of a global: any use that is NOT reading/writing the value
+// through it (the pointer operand of a load/store). `ret &G`, `icmp &G`, passing
+// &G, a select over &G -- all escape the address and must carry the canonical one.
+static bool echoIsValueAccess(const Use &U) {
+  const User *Usr = U.getUser();
+  if (const auto *LI = dyn_cast<LoadInst>(Usr))
+    return U.getOperandNo() == LI->getPointerOperandIndex();
+  if (const auto *SI = dyn_cast<StoreInst>(Usr))
+    return U.getOperandNo() == SI->getPointerOperandIndex();
+  return false;
+}
+
+// docs/07 §6 "deep home": an exported const object gets its ADDRESS homed to the face
+// copy (__echo_var), but a pointer FIELD inside it may point at an INTERNAL (local)
+// data blob that is NOT homed -- so the two worlds' copies of that blob differ, and a
+// cross-world pointer-identity comparison into it splits. Qt's QMetaObject is exactly
+// this: its `d.data` field points at the moc `qt_meta_data[]` (a `static const uint[]`,
+// local linkage), and QMetaMethod equality compares `data.d` -- a pointer INTO that
+// array. So a QMetaMethod built from the face SMO (guest connect) never equals one built
+// from the native SMO (host fromSignal). The fix homes the blob at HOST: the native copy
+// is authoritative (host graph untouched) and the FACE SMO's field is back-filled at the
+// publish handshake to point at the native blob (host writes guest memory; see
+// __echo_register_smo_patches / echo_apply_smo_patches).
+//
+// True if C embeds any relocation (a pointer to a global): such a blob may hold a
+// per-world address (QMetaType interface pointers in the metatypes array), so it is NOT
+// byte-portable and must NOT be homed. Pure scalar data (ints/chars: qt_meta_data,
+// stringdata) is relocation-free and safe.
+static bool echoConstHasRelocation(const Constant *C) {
+  if (isa<ConstantData>(C)) // ints, floats, zeroinit, undef, ConstantDataArray
+    return false;
+  if (isa<GlobalValue>(C) || isa<ConstantExpr>(C))
+    return true; // a global address, or ptrtoint/gep of one
+  for (const Use &U : C->operands())
+    if (const auto *Op = dyn_cast<Constant>(U.get()))
+      if (echoConstHasRelocation(Op))
+        return true;
+  return false;
+}
+
+// Walk C (an exported const object's initializer) at byte offset Off, collecting each
+// pointer field that needs deep-homing to the host copy:
+//   Data -- a field targeting an INTERNAL, relocation-free constant global (qt_meta_data
+//           / stringdata): homed so the guest and host see the one (native) data blob.
+//   Funcs -- a field targeting an exported FUNCTION (a QMetaObject's static_metacall):
+//           homed to the NATIVE function so a host caller that received a face SMO from
+//           the guest (QMetaMethod::fromSignalImpl walks m->static_metacall) invokes the
+//           native code, not the face's x86 stub. The caller only applies Funcs to a
+//           QMetaObject (static_metacall is the only such field), so ordinary callback
+//           tables are untouched. superdata (an exported SMO) is skipped (not local const
+//           data, not a function); metatypes (has relocations) is skipped by
+//           echoConstHasRelocation.
+static void echoCollectDeepHomeFields(
+    const DataLayout &DL, const Constant *C, uint64_t Off,
+    SmallVectorImpl<std::pair<uint64_t, GlobalVariable *>> &Data,
+    SmallVectorImpl<std::pair<uint64_t, Function *>> &Funcs) {
+  if (const auto *CS = dyn_cast<ConstantStruct>(C)) {
+    const StructLayout *SL = DL.getStructLayout(CS->getType());
+    for (unsigned i = 0, e = CS->getNumOperands(); i != e; ++i)
+      echoCollectDeepHomeFields(DL, CS->getOperand(i),
+                                Off + SL->getElementOffset(i), Data, Funcs);
+    return;
+  }
+  if (const auto *CA = dyn_cast<ConstantArray>(C)) {
+    uint64_t ES = DL.getTypeAllocSize(CA->getType()->getElementType());
+    for (unsigned i = 0, e = CA->getNumOperands(); i != e; ++i)
+      echoCollectDeepHomeFields(DL, CA->getOperand(i), Off + i * ES, Data, Funcs);
+    return;
+  }
+  if (auto *GV = dyn_cast<GlobalVariable>(const_cast<Constant *>(C))) {
+    if (GV->hasLocalLinkage() && GV->isConstant() && GV->hasInitializer() &&
+        !echoConstHasRelocation(GV->getInitializer()))
+      Data.push_back({Off, GV});
+    return;
+  }
+  if (auto *F = dyn_cast<Function>(const_cast<Constant *>(C))) {
+    StringRef N = F->getName();
+    if (!F->isIntrinsic() && F->hasExternalLinkage() &&
+        !N.starts_with("thunk_") && !N.starts_with("__echo") &&
+        !N.starts_with("echo_"))
+      Funcs.push_back({Off, F});
+  }
+}
+
+// docs/23 R-2: a canonical signature key for an indirect-call FunctionType, used
+// to name the per-signature host dispatcher / guest redispatcher and the
+// reverse-published __echo_redisp$<key> slot. face and native compile the same
+// source, so identical call-site types yield identical keys (hence matching
+// slots). Only the scalar/pointer classes the reentry path supports are encoded.
+static std::string echoTypeCode(Type *T) {
+  if (T->isVoidTy())
+    return "v";
+  if (T->isPointerTy())
+    return "p";
+  if (T->isIntegerTy())
+    return ("i" + Twine(T->getIntegerBitWidth())).str();
+  if (T->isFloatTy())
+    return "f32";
+  if (T->isDoubleTy())
+    return "f64";
+  return "x"; // unsupported class
+}
+
+// A small aggregate RETURNED IN REGISTERS (QRect = 16 bytes, QSize = 8) reaches the IR
+// as a TARGET-COERCED type: for one source type clang emits `{i64,i64}` on x86-64 and
+// `[2 x i64]` on AArch64. Keying on that type directly would give the face and the
+// native DIFFERENT signature keys, so the reverse-published __echo_redisp$<key> slot
+// would never match: a host->guest virtual call on a guest override (a QProxyStyle
+// subclass overriding subElementRect) then dispatches through a NULL slot and jumps to
+// garbage. Canonicalise to an INTEGER of the same rounded width instead -- both worlds
+// agree on it, the memory image is identical (the coercion is a bitwise
+// reinterpretation), and a genuine iN return maps to the same key, which is correct
+// because it shares the ABI. Returns T unchanged unless it is such a small aggregate.
+// (An aggregate too big for registers is returned INDIRECTLY: the IR type is void plus
+// an sret pointer parameter, already handled by echoAbiSuffix.)
+// Does every scalar leaf of T have floating-point class? That decides which registers
+// the ABI returns it in (SSE vs INTEGER on x86-64, an AAPCS64 HFA vs X0/X1), and it is
+// the one property BOTH targets' coerced types still agree on: x86 `{double,double}` and
+// AArch64 `[2 x double]` are both all-FP, x86 `{i64,i32}` and AArch64 `[2 x i64]` are
+// both all-integer. A MIXED aggregate is where they stop agreeing (x86 keeps `{i64,
+// double}` = RAX+XMM0, AArch64 flattens to `[2 x i64]` = X0/X1), so mixed stays
+// unsupported -- see echoRetCode.
+static bool echoAllFPLeaves(Type *T) {
+  if (T->isFloatingPointTy())
+    return true;
+  if (auto *VT = dyn_cast<VectorType>(T))
+    return VT->getElementType()->isFloatingPointTy();
+  if (auto *AT = dyn_cast<ArrayType>(T))
+    return echoAllFPLeaves(AT->getElementType());
+  if (auto *ST = dyn_cast<StructType>(T)) {
+    if (ST->getNumElements() == 0)
+      return false;
+    for (Type *E : ST->elements())
+      if (!echoAllFPLeaves(E))
+        return false;
+    return true;
+  }
+  return false;
+}
+
+// Does ANY scalar leaf have floating-point class? With echoAllFPLeaves this separates
+// all-FP / all-integer (both targets agree) from MIXED (they do not: x86-64 keeps
+// `{i64,double}` = RAX+XMM0 while AArch64 flattens to `[2 x i64]` = X0/X1).
+static bool echoAnyFPLeaf(Type *T) {
+  if (T->isFloatingPointTy())
+    return true;
+  if (auto *VT = dyn_cast<VectorType>(T))
+    return VT->getElementType()->isFloatingPointTy();
+  if (auto *AT = dyn_cast<ArrayType>(T))
+    return echoAnyFPLeaf(AT->getElementType());
+  if (auto *ST = dyn_cast<StructType>(T)) {
+    for (Type *E : ST->elements())
+      if (echoAnyFPLeaf(E))
+        return true;
+  }
+  return false;
+}
+
+/// Canonical carrier for a register-returned aggregate: same register class, width
+/// rounded up to whole eightbytes, identical on both targets. Calling a function that
+/// really returns a narrower member of the same class through this type is ABI-correct
+/// (both ride the same registers), which is what lets ONE dispatcher/redispatcher pair
+/// serve `{i64,i64}`, `{i64,i32}` and AArch64's `[2 x i64]` alike.
+static Type *echoCanonRetTy(Type *T, const DataLayout &DL) {
+  if (!T->isAggregateType() && !T->isVectorTy())
+    return T;
+  uint64_t Sz = DL.getTypeStoreSize(T).getFixedValue();
+  if (Sz == 0 || Sz > 16)
+    return T;
+  uint64_t N = (Sz + 7) / 8;
+  LLVMContext &C = T->getContext();
+  if (echoAllFPLeaves(T))
+    return ArrayType::get(Type::getDoubleTy(C), N);
+  if (echoAnyFPLeaf(T))
+    return T; // mixed class: unsupported (echoRetCode returns "x"), never carried
+  return Type::getIntNTy(C, (unsigned) (N * 64));
+}
+
+static std::string echoRetCode(Type *T, const DataLayout &DL) {
+  if (!T->isAggregateType() && !T->isVectorTy())
+    return echoTypeCode(T);
+  uint64_t Sz = DL.getTypeStoreSize(T).getFixedValue();
+  if (Sz == 0 || Sz > 16)
+    return "x"; // returned indirectly (sret), or no class the reentry path carries
+  uint64_t Bits = ((Sz + 7) / 8) * 64;
+  if (echoAllFPLeaves(T))
+    return ("af" + Twine(Bits)).str();
+  if (echoAnyFPLeaf(T))
+    return "x"; // mixed: the two targets disagree on the class, keep it unsupported
+  // All-integer: keyed exactly like a genuine iN return, which is right -- same
+  // registers, same memory image, so they can share one dispatcher.
+  return echoTypeCode(Type::getIntNTy(T->getContext(), (unsigned) Bits));
+}
+
+// The concrete signature of an indirect CALL SITE.
+//
+// A variadic callee type describes only the FIXED parameters, so keying on it would
+// lose every argument that actually travels. The call site knows them: rebuild the type
+// from the arguments really passed, and keep the varargs marker so the dispatcher still
+// emits a variadic call on the host path (x86-64 needs AL set, and only a varargs call
+// site sets it).
+//
+// Face and native compile the same source and therefore see the same arguments at the
+// same site, so both derive the same type and name the same echo_dispatch_ /
+// echo_redispatch_ pair. That symmetry is what the publish handshake keys on.
+static FunctionType *echoCallSiteFT(CallBase *CB) {
+  FunctionType *FT = CB->getFunctionType();
+  if (!FT->isVarArg())
+    return FT;
+  SmallVector<Type *, 8> Params;
+  for (const Use &A : CB->args())
+    Params.push_back(A->getType());
+  return FunctionType::get(FT->getReturnType(), Params, /*isVarArg=*/true);
+}
+
+static std::string echoSignatureKey(FunctionType *FT, const DataLayout &DL) {
+  std::string S = echoRetCode(FT->getReturnType(), DL);
+  for (Type *P : FT->params())
+    S += "_" + echoTypeCode(P);
+  /// A variadic site must not share a dispatcher with a fixed one of the same shape:
+  /// the two differ in how the host-path call is emitted.
+  if (FT->isVarArg())
+    S += "_va";
+  return S;
+}
+
+// Only reenter through signatures whose every component is a class the flat
+// argblock + native reconstruction can carry (one 8-byte slot each). Anything
+// with an "x" code (a big aggregate, ...) keeps the old translate-only path. The
+// RETURN position is wider than the parameter positions: it travels through a return
+// BUFFER, not an argblock slot, so a register-returned small aggregate is carried fine
+// once it has an arch-invariant key (echoCanonRetTy).
+static bool echoSigSupported(FunctionType *FT, const DataLayout &DL) {
+  /// A variadic type is judged on the CONCRETE parameters echoCallSiteFT built from the
+  /// call site. Rejecting varargs outright left the site on the translate-only path,
+  /// which has no way back into guest code, so a host->guest call through a variadic
+  /// function pointer jumped straight at a guest address and faulted on the host.
+  /// libxml2's error handler is exactly that: void (*)(void *, const char *, ...).
+  if (echoRetCode(FT->getReturnType(), DL) == "x")
+    return false;
+  for (Type *P : FT->params())
+    if (echoTypeCode(P) == "x")
+      return false;
+  return true;
+}
+
+// sret/byval/inreg are carried as parameter ATTRIBUTES, not in the LLVM type, and
+// they change how a call lays out registers (an sret pointer rides x8 on AArch64, a
+// byval aggregate is copied). echoTypeCode/echoSignatureKey see only types, so a
+// `void(ptr sret, ...)` call (an aggregate-returning method like QSystemLocale::query
+// returning QVariant) keys identically to a genuine `void(ptr, ...)` call. Two things
+// follow: (1) they must get DISTINCT dispatchers -- append the ABI attrs to the key;
+// (2) the dispatcher and its native call must REPLAY those attrs or the sret pointer
+// lands in x0 instead of x8 and every argument shifts (garbage this -> crash).
+static std::string echoAbiSuffix(Module &M, const AttributeList &AL, unsigned N) {
+  std::string S;
+  const DataLayout &DL = M.getDataLayout();
+  for (unsigned I = 0; I < N; ++I) {
+    AttributeSet PA = AL.getParamAttrs(I);
+    if (PA.hasAttribute(Attribute::StructRet))
+      S += "S" + std::to_string(I);
+    if (PA.hasAttribute(Attribute::ByVal))
+      S += "B" + std::to_string(I) + "n" +
+           std::to_string(DL.getTypeAllocSize(PA.getByValType()).getFixedValue());
+    if (PA.hasAttribute(Attribute::InReg))
+      S += "R" + std::to_string(I);
+  }
+  return S.empty() ? std::string() : ("$" + S);
+}
+
+// Shift a callee's parameter attributes right by one (dispatcher + rewritten call
+// site both prepend the function pointer). Return attrs kept; function attrs dropped
+// (the dispatcher has its own behavior -- e.g. it may unwind on the guest path even
+// when the callee is nounwind).
+static AttributeList echoShiftAttrs(LLVMContext &C, const AttributeList &AL,
+                                    unsigned N) {
+  SmallVector<AttributeSet, 8> Args;
+  Args.push_back(AttributeSet()); // the prepended fp: no attrs
+  for (unsigned I = 0; I < N; ++I)
+    Args.push_back(AL.getParamAttrs(I));
+  return AttributeList::get(C, AttributeSet(), AL.getRetAttrs(), Args);
+}
+
+// The reverse-published guest-dispatcher slot __echo_redisp$<key>: a linkonce-ODR
+// null pointer (default visibility so the face's dlsym fills it at the handshake,
+// same channel as __echo_facevt$<vtable>). Native dispatchers load it.
+static GlobalVariable *echoRedispSlot(Module &M, StringRef Key, Type *PtrTy) {
+  std::string Name = ("__echo_redisp$" + Key).str();
+  if (auto *G = M.getNamedGlobal(Name))
+    return G;
+  auto *G = new GlobalVariable(M, PtrTy, /*isConstant=*/false,
+                               GlobalValue::LinkOnceODRLinkage,
+                               ConstantPointerNull::get(cast<PointerType>(PtrTy)),
+                               Name);
+  G->setVisibility(GlobalValue::DefaultVisibility);
+  return G;
+}
+
+// FNV-1a-64 over the worklist function names (with a separator). face and native
+// compile the same source in the same order, so both sides agree; a mismatch at
+// the publish handshake (docs/19 §6b) means the two .so were built differently.
+static uint64_t echoVersionHash(const SmallVectorImpl<Function *> &Worklist) {
+  uint64_t H = 0xcbf29ce484222325ULL;
+  for (const Function *F : Worklist) {
+    for (char Ch : echoNeutralName(*F)) {
+      H ^= (unsigned char)Ch;
+      H *= 0x100000001b3ULL;
+    }
+    H *= 0x100000001b3ULL; // name separator (xor 0 is a no-op)
+  }
+  return H;
+}
+
+// Arch-invariant module id: FNV-1a-64 over the source file name. The face and
+// native compile the same .cpp, so both sides agree regardless of any arch-#ifdef
+// divergence inside the file — unlike echoVersionHash (over the worklist), which
+// legitimately differs when a class is compiled on only one arch. Used to name the
+// publish symbol so the face resolves its module's native publisher; the actual
+// binding is then done by function NAME (tolerating per-arch-only functions).
+static uint64_t echoSourceHash(const Module &M) {
+  uint64_t H = 0xcbf29ce484222325ULL;
+  for (char Ch : M.getSourceFileName()) {
+    H ^= (unsigned char)Ch;
+    H *= 0x100000001b3ULL;
+  }
+  return H;
+}
+
+// Diagnostic (ECHO_DUMP_WL=1): print a module's binding worklist so the face (x86)
+// and native (other-arch) halves can be diffed when a publish hash mismatches.
+static void echoDumpWorklist(const char *Side, const Module &M,
+                             const SmallVectorImpl<Function *> &WL) {
+  if (!::getenv("ECHO_DUMP_WL") || WL.empty())
+    return;
+  errs() << "ECHO-WL " << Side << " " << M.getSourceFileName() << " "
+         << Twine::utohexstr(echoVersionHash(WL)) << " n=" << WL.size() << ":";
+  for (const Function *F : WL)
+    errs() << " " << F->getName();
+  errs() << "\n";
+}
+
+// Diagnostic (ECHO_DUMP_VARS=1): list every EXPORTED MUTABLE global (the candidates
+// for storage sync, docs/07 §5), independent of whether the sync gate is currently
+// open. Each line: module, name, atomic=<0|1> (echoHasAtomicUse), scalar=<0|1>. The
+// mutable-sync deep-dive uses this to enumerate + bisect the non-atomic scalar global
+// that corrupts real Qt's R-3 virtual-call marshalling. Runs regardless of the gate.
+static void echoDumpMutableVars(const Module &M) {
+  if (!::getenv("ECHO_DUMP_VARS"))
+    return;
+  for (const GlobalVariable &G : M.globals()) {
+    if (G.isDeclaration() || !G.hasInitializer() || G.isConstant())
+      continue;
+    if (G.hasLocalLinkage() || !G.hasDefaultVisibility() ||
+        G.hasAppendingLinkage() || G.isThreadLocal())
+      continue;
+    StringRef N = G.getName();
+    if (N.starts_with("llvm.") || N.starts_with("__echo") ||
+        N.starts_with("echo_") || N.starts_with("_ZTV") ||
+        N.starts_with("_ZTI") || N.starts_with("_ZTS"))
+      continue;
+    Type *T = G.getValueType();
+    errs() << "ECHO-MUTVAR " << M.getSourceFileName() << " " << N
+           << " atomic=" << (echoHasAtomicUse(G) ? 1 : 0)
+           << " scalar="
+           << ((T->isIntegerTy() || T->isFloatingPointTy() || T->isPointerTy()) ? 1
+                                                                                 : 0)
+           << "\n";
+  }
+}
+
+// Shared Echo ABI call lowering, included by the thin X86 and AArch64 passes.
+// Target-independent IR rewrite (the backend does the per-ABI arg classification);
+// the face half is always x86, so EmitFace is only ever true on the X86 target.
+static bool echoRunOnModule(Module &M, bool EmitFace) {
+  if (M.getTargetTriple().getEnvironment() != Triple::Echo)
+    return false;
+  return EmitFace ? runFace(M) : runNative(M);
+}
+
+// docs/23 R-2: get-or-emit the per-signature host dispatcher echo_dispatch_<key>.
+// At every native indirect call site `r = fp(args)` the rewrite calls this
+// dispatcher with fp prepended; it routes:
+//   t = __echo_check_call(fp)      // face stub -> native body, else fp
+//   if (__echo_is_host(t)) r = t(args)             // host body: call natively
+//   else { pack args, build EchoReentry, __echo_reenter; r = retbuf }  // -> guest
+// The guest branch is the exact mirror of the face's outbound face_pack_*.
+static Function *echoGetDispatch(Module &M, FunctionType *FT,
+                                 const AttributeList &AL) {
+  LLVMContext &C = M.getContext();
+  Type *PtrTy = PointerType::getUnqual(C);
+  Type *I8Ty = Type::getInt8Ty(C);
+  Type *I32Ty = Type::getInt32Ty(C);
+  Type *VoidTy = Type::getVoidTy(C);
+
+  const DataLayout &DL0 = M.getDataLayout();
+  std::string Key =
+      echoSignatureKey(FT, DL0) + echoAbiSuffix(M, AL, FT->getNumParams());
+  std::string Name = "echo_dispatch_" + Key;
+
+  // A register-returned aggregate travels as its CANONICAL carrier (echoCanonRetTy):
+  // one dispatcher per key, whatever coerced type each call site happens to have. It has
+  // to be the type and not just the key, because the two targets do not even agree on
+  // how many distinct types there are -- AArch64 flattens {i64,i64} and {i64,i32} to the
+  // same [2 x i64], so x86 must serve both through one dispatcher too. Same register
+  // class and >= the real width, so the conversions below are pure reinterpretation.
+  Type *CanonRet = echoCanonRetTy(FT->getReturnType(), DL0);
+  // The dispatcher is shared by every call site with this key, and those sites can have
+  // DIFFERENT coerced return types ({i64,i64} and {i64,i8} are both "i128"). So the call
+  // it makes on the host path must use the CANONICAL type too -- calling through the
+  // creating site's own type would move only that type's width and leave the rest of a
+  // wider caller's value undefined. (This is exactly how QMargins lost its 4th int to a
+  // dispatcher first created for a 9-byte struct: `movb %dl` instead of `movq %rdx`.)
+  // Legal because the canonical carrier keeps the register class and is the widest
+  // member of it.
+  FunctionType *CallFT =
+      CanonRet == FT->getReturnType()
+          ? FT
+          : FunctionType::get(CanonRet, FT->params(), FT->isVarArg());
+
+  SmallVector<Type *, 8> Params;
+  Params.push_back(PtrTy); // fp
+  for (Type *P : FT->params())
+    Params.push_back(P);
+  FunctionType *DT = FunctionType::get(CanonRet, Params, false);
+  if (auto *Ex = M.getFunction(Name))
+    return Ex; // the key determines DT exactly, so a match is always type-correct
+  Function *D =
+      Function::Create(DT, GlobalValue::InternalLinkage, Name, &M);
+  // Replay the callee's param/return attrs (shifted past fp) so the CALLER passes an
+  // sret pointer in x8 etc. into this dispatcher.
+  D->setAttributes(echoShiftAttrs(C, AL, FT->getNumParams()));
+
+  FunctionCallee Xlate = M.getOrInsertFunction(
+      "__echo_check_call", FunctionType::get(PtrTy, {PtrTy}, false));
+  FunctionCallee IsHost = M.getOrInsertFunction(
+      "__echo_is_host", FunctionType::get(I32Ty, {PtrTy}, false));
+  FunctionCallee Reenter = M.getOrInsertFunction(
+      "__echo_reenter", FunctionType::get(VoidTy, {PtrTy}, false));
+  GlobalVariable *Redisp = echoRedispSlot(M, Key, PtrTy);
+
+  bool IsVoid = FT->getReturnType()->isVoidTy();
+  BasicBlock *Entry = BasicBlock::Create(C, "entry", D);
+  BasicBlock *HostBB = BasicBlock::Create(C, "host", D);
+  BasicBlock *GuestBB = BasicBlock::Create(C, "guest", D);
+  BasicBlock *Cont = BasicBlock::Create(C, "cont", D);
+
+  Constant *NullP = ConstantPointerNull::get(cast<PointerType>(PtrTy));
+
+  IRBuilder<> B(Entry);
+  Value *Fp = D->getArg(0);
+  Value *T = B.CreateCall(Xlate, {Fp});
+  Value *IsH = B.CreateCall(IsHost, {T});
+  B.CreateCondBr(B.CreateICmpNE(IsH, B.getInt32(0)), HostBB, GuestBB);
+
+  SmallVector<Value *, 8> Args;
+  for (unsigned I = 1, E = D->arg_size(); I < E; ++I)
+    Args.push_back(D->getArg(I));
+
+  // host body: a plain native indirect call with the real signature AND the callee's
+  // ABI attributes (sret/byval/...), so e.g. the sret pointer rides x8 as the native
+  // body expects.
+  IRBuilder<> HB(HostBB);
+  CallInst *HRC = HB.CreateCall(CallFT, T, Args);
+  HRC->setAttributes(AL);
+  Value *HR = HRC; // already the canonical carrier: CallFT returns it
+  HB.CreateBr(Cont);
+
+  // guest callback: pack args, reenter, read the return buffer. Uses the SAME
+  // echoArgLayout as the leaf face_pack/thunk so a byval aggregate rides the argblock
+  // inline (its bytes copied in) rather than as a pointer -- a raw pointer here would
+  // be a host address the reentered guest cannot dereference. The face's redispatcher
+  // reads back with the identical layout.
+  IRBuilder<> GB(GuestBB);
+  unsigned N = FT->getNumParams();
+  const DataLayout &DL = M.getDataLayout();
+  SmallVector<EchoSlotInfo, 8> Slots;
+  uint64_t ArgbufSize = echoArgLayout(FT, AL, DL, Slots);
+  Value *Argbuf = NullP;
+  if (ArgbufSize) {
+    Argbuf = GB.CreateAlloca(ArrayType::get(I8Ty, ArgbufSize));
+    cast<AllocaInst>(Argbuf)->setAlignment(Align(16));
+    for (unsigned I = 0; I < N; ++I) {
+      const EchoSlotInfo &S = Slots[I];
+      Value *Slot = GB.CreateGEP(I8Ty, Argbuf, {GB.getInt64(S.Off)});
+      if (S.ByvalTy)
+        GB.CreateMemCpy(Slot, Align(8), Args[I],
+                        AL.getParamAttrs(I).getAlignment().valueOrOne(),
+                        GB.getInt64(S.Size));
+      else
+        GB.CreateAlignedStore(Args[I], Slot, Align(8));
+    }
+  }
+  Value *RetBuf = NullP;
+  if (!IsVoid) {
+    // Sized by the CANONICAL width, not by this target's coerced type: the face (x86)
+    // and the native (possibly aarch64) coerce one source return type to types of
+    // different width, and this buffer must hold whatever the FACE stores into it.
+    RetBuf = GB.CreateAlloca(CanonRet);
+    cast<AllocaInst>(RetBuf)->setAlignment(Align(16));
+  }
+  Value *Re = GB.CreateAlloca(ArrayType::get(I8Ty, EchoReentrySize));
+  cast<AllocaInst>(Re)->setAlignment(Align(EchoSlot));
+  auto reField = [&](uint64_t Off) {
+    return GB.CreateGEP(I8Ty, Re, {GB.getInt64(Off)});
+  };
+  // Exception-across-reentry: an EchoException channel the reentered guest callback
+  // fills if it throws (via the redispatcher's landingpad -> __echo_catch_reentry).
+  // Carried in the otherwise-unused EchoReentry.varargs slot -- no ABI size change.
+  Value *Exc = GB.CreateAlloca(ArrayType::get(I8Ty, EchoExceptionSize));
+  cast<AllocaInst>(Exc)->setAlignment(Align(EchoSlot));
+  GB.CreateMemSet(Exc, GB.getInt8(0), GB.getInt64(EchoExceptionSize),
+                  Align(EchoSlot));
+  GB.CreateAlignedStore(T, reField(EchoReGuestFnOff), Align(EchoSlot));
+  GB.CreateAlignedStore(GB.CreateLoad(PtrTy, Redisp),
+                        reField(EchoReDispatcherOff), Align(EchoSlot));
+  GB.CreateAlignedStore(Argbuf, reField(EchoReArgblockOff), Align(EchoSlot));
+  GB.CreateAlignedStore(RetBuf, reField(EchoReRetOff), Align(EchoSlot));
+  GB.CreateAlignedStore(Exc, reField(EchoReVarargsOff), Align(EchoSlot));
+  GB.CreateCall(Reenter, {Re});
+
+  // Did the callback throw? EchoException.obj@16 (Tier-2/builtin) or .type@0 (Tier-1)
+  // is set. If so, rethrow a matching host exception -- it unwinds out of this
+  // dispatcher into the host caller's own catch.
+  Value *EObj = GB.CreateAlignedLoad(PtrTy, GB.CreateGEP(I8Ty, Exc, {GB.getInt64(16)}),
+                                     Align(EchoSlot));
+  Value *EType = GB.CreateAlignedLoad(I32Ty, Exc, Align(EchoSlot));
+  Value *Had = GB.CreateOr(GB.CreateICmpNE(EObj, NullP),
+                           GB.CreateICmpNE(EType, GB.getInt32(0)));
+  BasicBlock *ThrowBB = BasicBlock::Create(C, "reexc", D);
+  BasicBlock *OkBB = BasicBlock::Create(C, "reok", D);
+  GB.CreateCondBr(Had, ThrowBB, OkBB);
+
+  IRBuilder<> TB(ThrowBB);
+  TB.CreateCall(M.getOrInsertFunction("__echo_rethrow_reentry",
+                                      FunctionType::get(VoidTy, {PtrTy}, false)),
+                {Exc});
+  TB.CreateUnreachable();
+
+  IRBuilder<> OB(OkBB);
+  // The face's redispatcher stored the canonical carrier here, so read it back as such.
+  Value *GR = IsVoid ? nullptr : OB.CreateAlignedLoad(CanonRet, RetBuf, Align(16));
+  OB.CreateBr(Cont);
+
+  IRBuilder<> CB(Cont);
+  if (IsVoid) {
+    CB.CreateRetVoid();
+  } else {
+    PHINode *Phi = CB.CreatePHI(CanonRet, 2);
+    Phi->addIncoming(HR, HostBB);
+    Phi->addIncoming(GR, OkBB);
+    CB.CreateRet(Phi);
+  }
+  return D;
+}
+
+// docs/23 R-2 (face side): emit echo_redispatch_<key>, the GUEST-side unpacker
+// that the reentry loop runs. Mirror of the native entry thunk: unpack argblock
+// per the signature and call guest_fn, store the result into ret.
+static Function *echoGetRedispatch(Module &M, FunctionType *FT,
+                                   const AttributeList &AL) {
+  LLVMContext &C = M.getContext();
+  Type *PtrTy = PointerType::getUnqual(C);
+  Type *I8Ty = Type::getInt8Ty(C);
+  Type *VoidTy = Type::getVoidTy(C);
+
+  const DataLayout &RDL = M.getDataLayout();
+  std::string Key =
+      echoSignatureKey(FT, RDL) + echoAbiSuffix(M, AL, FT->getNumParams());
+  std::string Name = "echo_redispatch_" + Key;
+  if (auto *Ex = M.getFunction(Name))
+    return Ex;
+
+  // Call the guest callback through the CANONICAL return carrier, exactly as the native
+  // dispatcher expects to read it back. Legal because the carrier keeps the real type's
+  // register class and is at least as wide: an override really returning {i64,i32} still
+  // hands back RAX:RDX, and the extra bytes the buffer then holds are never read.
+  FunctionType *CallFT = FT;
+  if (Type *CR = echoCanonRetTy(FT->getReturnType(), RDL); CR != FT->getReturnType())
+    CallFT = FunctionType::get(CR, FT->params(), FT->isVarArg());
+
+  // void redispatch(void *guest_fn, void *argblock, void *ret, void *varargs)
+  FunctionType *RT =
+      FunctionType::get(VoidTy, {PtrTy, PtrTy, PtrTy, PtrTy}, false);
+  Function *R =
+      Function::Create(RT, GlobalValue::InternalLinkage, Name, &M);
+
+  IRBuilder<> B(BasicBlock::Create(C, "entry", R));
+  Value *Gf = R->getArg(0);
+  Value *Ab = R->getArg(1);
+  Value *Ret = R->getArg(2);
+
+  // Unpack with the SAME echoArgLayout the native dispatcher packed with: a byval(T)
+  // slot carries the aggregate inline, so rebuild a local copy and pass it byval (its
+  // bytes are guest-local now); every other slot loads its value directly.
+  const DataLayout &DL = M.getDataLayout();
+  SmallVector<EchoSlotInfo, 8> Slots;
+  echoArgLayout(FT, AL, DL, Slots);
+  SmallVector<Value *, 8> Args;
+  unsigned N = FT->getNumParams();
+  for (unsigned I = 0; I < N; ++I) {
+    const EchoSlotInfo &S = Slots[I];
+    Value *Slot = B.CreateGEP(I8Ty, Ab, {B.getInt64(S.Off)});
+    if (S.ByvalTy) {
+      Align BvAl = AL.getParamAttrs(I).getAlignment().valueOrOne();
+      Value *Tmp = B.CreateAlloca(S.ByvalTy);
+      cast<AllocaInst>(Tmp)->setAlignment(BvAl);
+      B.CreateMemCpy(Tmp, BvAl, Slot, Align(8), B.getInt64(S.Size));
+      Args.push_back(Tmp);
+    } else {
+      Args.push_back(B.CreateAlignedLoad(FT->getParamType(I), Slot, Align(1)));
+    }
+  }
+
+  // Exception-across-reentry (reverse of the C-3 tunnel): the guest callback may
+  // throw. Invoke it; on unwind a catch-all landingpad records the exception into the
+  // EchoException channel the host passed via EchoReentry.varargs (this redispatcher's
+  // 4th arg), then returns normally -- the host rethrows on its side after the reentry
+  // (HostRT/ReentryRethrow.cpp). Mirror of the native entry thunk's C-3 landingpad.
+  Type *I32Ty = Type::getInt32Ty(C);
+  R->setPersonalityFn(cast<Constant>(
+      M.getOrInsertFunction("__gxx_personality_v0", FunctionType::get(I32Ty, true))
+          .getCallee()));
+  BasicBlock *Cont = BasicBlock::Create(C, "cont", R);
+  BasicBlock *Lpad = BasicBlock::Create(C, "lpad", R);
+  InvokeInst *Inv = B.CreateInvoke(CallFT, Gf, Cont, Lpad, Args);
+  Inv->setAttributes(AL); // sret/byval so the guest callback gets the right ABI
+  Value *Res = Inv;
+
+  IRBuilder<> LB(Lpad);
+  LandingPadInst *LP =
+      LB.CreateLandingPad(StructType::get(C, {PtrTy, I32Ty}), 0);
+  LP->addClause(ConstantPointerNull::get(cast<PointerType>(PtrTy)));
+  Value *ExcObj = LB.CreateCall(
+      M.getOrInsertFunction("__cxa_begin_catch",
+                            FunctionType::get(PtrTy, {PtrTy}, false)),
+      {LB.CreateExtractValue(LP, 0)});
+  LB.CreateCall(M.getOrInsertFunction(
+                    "__echo_catch_reentry",
+                    FunctionType::get(VoidTy, {PtrTy, PtrTy}, false)),
+                {R->getArg(3), ExcObj}); // arg3 = varargs = the EchoException channel
+  LB.CreateCall(M.getOrInsertFunction("__cxa_end_catch",
+                                      FunctionType::get(VoidTy, false)));
+  LB.CreateRetVoid();
+
+  B.SetInsertPoint(Cont);
+  if (!FT->getReturnType()->isVoidTy())
+    B.CreateAlignedStore(Res, Ret, Align(1));
+  B.CreateRetVoid();
+  return R;
+}
+
+// B-1: for each exported leaf function F, emit thunk_F(EchoCallBlock*) that
+// unpacks F's arguments and calls F (the native body lives in this same object).
+static bool runNative(Module &M) {
+  LLVMContext &C = M.getContext();
+  Type *PtrTy = PointerType::getUnqual(C);
+  Type *I8Ty = Type::getInt8Ty(C);
+  FunctionType *ThunkTy = FunctionType::get(Type::getVoidTy(C), {PtrTy}, false);
+
+  SmallVector<Function *, 16> Worklist;
+  for (Function &F : M)
+    if (isEchoExport(F))
+      Worklist.push_back(&F);
+  echoCollectVtableFns(M, Worklist);
+  echoCollectEscapingFns(M, Worklist);
+  // Before the sort: both halves order the worklist identically and the publish handshake
+  // depends on that agreement, so anything added afterwards would desynchronise them.
+  echoCollectInternalEscapers(M, Worklist);
+  // Sort by name so the binding-slot layout and version hash are arch-invariant:
+  // the face (x86) and native (e.g. aarch64) compile the same source under
+  // different target pipelines, which can leave M's function order differing, and
+  // the publish handshake keys on both halves agreeing exactly (docs/19 §6b).
+  llvm::sort(Worklist, [](const Function *A, const Function *B) {
+    return echoNeutralName(*A) < echoNeutralName(*B);
+  });
+  echoDumpWorklist("native", M, Worklist);
+  echoDumpMutableVars(M);
+
+  bool Changed = false;
+
+  // Canonicalise escaping function addresses to the face address (see
+  // echoEscapesAsValue). Done first, on pristine IR, so it never touches the
+  // native-address uses this pass itself emits below (thunk table, __echo_publish).
+  // Each escaping F routes through __echo_faceaddr$F: null until the reverse-
+  // publish handshake fills it with F's face stub, with a branchless fall back to
+  // the native &F when unfilled -- so a plain host process (no guest, slot null)
+  // gets a self-consistent native pointer and the library works stand-alone.
+  {
+    auto *NullP = ConstantPointerNull::get(cast<PointerType>(PtrTy));
+    // Insertion point for a value use: before the using instruction, or (for a phi
+    // operand) at the end of the matching predecessor so it dominates the edge.
+    auto ipFor = [](Instruction *I, const Use &U) -> Instruction * {
+      if (auto *Phi = dyn_cast<PHINode>(I))
+        return Phi->getIncomingBlock(U)->getTerminator();
+      return I;
+    };
+    auto skipUser = [](Instruction *I, const Use &U) {
+      if (auto *CB = dyn_cast<CallBase>(I))
+        if (&CB->getCalledOperandUse() == &U)
+          return true; // direct call target stays native
+      StringRef PN = I->getFunction()->getName();
+      return PN.starts_with("__echo") || PN.starts_with("thunk_") ||
+             PN.starts_with("echo_dispatch_") ||
+             PN.starts_with("echo_redispatch_") || PN == "echo_gen_resolve";
+    };
+    // Scan EVERY external-linkage function, not just the Worklist (which holds only
+    // functions DEFINED here): a signal PMF is often formed in a TU where the signal
+    // is merely an extern DECLARATION -- qbuffer.cpp forms ptrtoint(@QIODevice::readyRead)
+    // though readyRead is defined in qiodevice.cpp. The __echo_faceaddr$F slot is keyed
+    // by name and linkonce, so the referencing TU's canonicalisation binds to the same
+    // slot the defining TU publishes; a slot that no module publishes stays null and the
+    // branchless fallback yields &F_native, so a non-Echo function (libc &memcmp) is safe.
+    for (Function &Fn : M) {
+      Function *F = &Fn;
+      // An INTERNAL function's address escapes just as well: a C library's plugin table
+      // is usually filled with file-local implementations (lcms2's LinLerp1D). Its slot
+      // name carries the module hash, because an internal name is only unique within its
+      // own module and a bare __echo_faceaddr$init would collide across libraries. Both
+      // halves compile the same source, so echoSourceHash agrees.
+      if (F->isIntrinsic())
+        continue;
+      // A DECLARATION's address escapes too. The comment just above says this loop scans
+      // every external-linkage function precisely because a signal PMF is usually formed
+      // in a TU where the signal is only an extern declaration -- but the code then
+      // skipped exactly those, so the one thing that has to be single-valued was split in
+      // two. The library that DEFINES the signal canonicalised it to the face stub, every
+      // library that merely imports it kept the native address, and moc's
+      // qt_static_metacall(IndexOfMethod) -- which resolves a new-style
+      //     connect(model, &QQmlObjectModel::countChanged, ...)
+      // by COMPARING member-function pointers one by one -- never matched. Qt reported
+      // "signal not found in <class>" 99 times in a single Controls start-up; that is why
+      // a TabBar measured zero high (QQmlObjectModel lost countChanged) and a Dialog never
+      // became visible (QQuickPopupItem lost its wiring).
+      //
+      // Gated on the PMF form alone, NOT on "is a declaration" -- that is the property
+      // that has to be single-valued, and it is a property of the FUNCTION, so both worlds
+      // and every TU classify it identically. Letting every declaration through instead
+      // does fix the connects, but it also canonicalises plain callbacks handed to code
+      // outside this world and regressed the small Quick scene into a guest SIGILL.
+      if (F->isDeclaration() && !echoUsedAsPmf(*F))
+        continue;
+      // linkonce_odr / weak_odr counts too, and leaving it out was a hole the size of
+      // C++ itself: every inline member and every template instantiation lands there.
+      // RocksDB's CachableEntry<Block>::ReleaseCacheHandle is a static member of a class
+      // template, so it is linkonce_odr, so it was skipped, so the cleanup pointer the
+      // native half registered in a guest-owned PinnableSlice stayed native and the guest
+      // called into aarch64 text. The slot name stays the plain mangled name (no module
+      // hash): an ODR name is unique across the whole program by definition, which is
+      // exactly what makes one slot correct for every TU that instantiates it.
+      if (!F->hasExternalLinkage() && !F->hasInternalLinkage() &&
+          !F->hasLinkOnceODRLinkage() && !F->hasWeakODRLinkage())
+        continue;
+      if (echoIsGlueName(F->getName()))
+        continue;
+      if (!echoComparedAsValue(*F))
+        continue;
+      auto *Slot = cast<GlobalVariable>(
+          M.getOrInsertGlobal(echoFaceAddrSlotName(M, *F), PtrTy));
+      if (!Slot->hasInitializer()) {
+        Slot->setInitializer(NullP);
+        Slot->setLinkage(GlobalValue::LinkOnceODRLinkage);
+      }
+      // faceAddr(B) = slot ? slot : &F_native  (branchless; native fallback keeps
+      // the library correct stand-alone when the slot is never published).
+      auto faceAddr = [&](IRBuilder<> &B) -> Value * {
+        Value *L = B.CreateLoad(PtrTy, Slot);
+        return B.CreateSelect(B.CreateICmpEQ(L, NullP), F, L);
+      };
+
+      // Rewrite the identity idioms: a direct `icmp ... @F`; the PMF integer form
+      // `ptrtoint(@F)` (its EVERY non-glue use -- the compare may be in another TU, so
+      // a `store ptrtoint(@F)` into a PMF handed to fromSignal must carry the face
+      // address too); and `icmp i64 %x, bitcast(@F)`. A plain callable `ptr @F` (a
+      // direct call target, a native callback) keeps the native address.
+      // EVERY instruction use of F as a value, not a list of use kinds. See
+      // echoComparedAsValue: an enumeration silently misses whatever the optimiser
+      // happens to produce, and a select is what it produced for lcms2.
+      SmallVector<Use *, 8> CmpUses;
+      SmallVector<Use *, 4> SyncStoreUses;  // kept for ordering; filled by the same scan
+      SmallVector<ConstantExpr *, 4> PtiWrappers;   // ptrtoint(F): the PMF integer form
+      SmallVector<ConstantExpr *, 4> BcCmpWrappers; // bitcast(F) used by an icmp
+      for (Use &U : F->uses()) {
+        User *Usr = U.getUser();
+        if (auto *I = dyn_cast<Instruction>(Usr)) {
+          if (!skipUser(I, U))
+            CmpUses.push_back(&U);
+        } else if (auto *CE = dyn_cast<ConstantExpr>(Usr)) {
+          if (CE->getOpcode() == Instruction::PtrToInt)
+            PtiWrappers.push_back(CE);
+          else if (CE->getOpcode() == Instruction::BitCast &&
+                   llvm::any_of(CE->users(),
+                                [](const User *UU) { return isa<ICmpInst>(UU); }))
+            BcCmpWrappers.push_back(CE);
+        }
+      }
+      for (Use *U : CmpUses) {
+        auto *I = cast<Instruction>(U->getUser());
+        IRBuilder<> B(ipFor(I, *U));
+        U->set(faceAddr(B));
+        Changed = true;
+      }
+      for (Use *U : SyncStoreUses) {
+        auto *I = cast<Instruction>(U->getUser());
+        IRBuilder<> B(ipFor(I, *U));
+        U->set(faceAddr(B));
+        Changed = true;
+      }
+      for (ConstantExpr *CE : PtiWrappers) {
+        SmallVector<Use *, 4> CEUses;
+        for (Use &UU : CE->uses())
+          if (auto *I = dyn_cast<Instruction>(UU.getUser()))
+            if (!skipUser(I, UU))
+              CEUses.push_back(&UU);
+        for (Use *UU : CEUses) {
+          auto *I = cast<Instruction>(UU->getUser());
+          IRBuilder<> B(ipFor(I, *UU));
+          UU->set(B.CreatePtrToInt(faceAddr(B), CE->getType()));
+          Changed = true;
+        }
+      }
+      for (ConstantExpr *CE : BcCmpWrappers) {
+        SmallVector<Use *, 4> CEUses;
+        for (Use &UU : CE->uses())
+          if (auto *I = dyn_cast<ICmpInst>(UU.getUser()))
+            if (!skipUser(I, UU))
+              CEUses.push_back(&UU);
+        for (Use *UU : CEUses) {
+          auto *I = cast<Instruction>(UU->getUser());
+          IRBuilder<> B(ipFor(I, *UU));
+          UU->set(B.CreateBitCast(faceAddr(B), CE->getType()));
+          Changed = true;
+        }
+      }
+    }
+  }
+
+  // Exported globals: canonicalise to the face copy (see isEchoSyncableVar /
+  // docs/07) through the __echo_var$G slot (face-published; null -> native fallback
+  // keeps the library correct stand-alone). A CONST global needs only its ADDRESS
+  // canonicalised (identical bytes, so value reads/writes are untouched), fixing a
+  // cross-world identity comparison (qobject_cast on &staticMetaObject). A MUTABLE
+  // global is a storage divergence, so EVERY use -- loads and stores included -- is
+  // redirected to the one canonical storage, so a host write and a guest read hit
+  // the same location. This runs for a mutable global DEFINED here AND for one merely
+  // DECLARED here (isEchoSyncableMutDeclRef): the definition alone is not enough,
+  // because a module that references the global through a declaration would otherwise
+  // read the un-synced native copy while the defining module wrote the face copy --
+  // the cross-module divergence that broke real Qt (docs/07 §5). (A write during
+  // native static init, before the slot is published, still lands in the native copy;
+  // carrying that forward is a later refinement -- runtime writes, the qApp case,
+  // work here.)
+  {
+    auto *NullP = ConstantPointerNull::get(cast<PointerType>(PtrTy));
+    for (GlobalVariable &G : M.globals()) {
+      bool Defined = isEchoSyncableVar(G);
+      bool MutDecl = !Defined && isEchoSyncableMutDeclRef(G);
+      bool ConstDecl = !Defined && !MutDecl && isEchoSyncableConstDeclRef(G);
+      if (!Defined && !MutDecl && !ConstDecl)
+        continue;
+      // ConstDecl is an aggregate/const extern: address-only, even though its declaration
+      // may be spelled `global`. A defined mutable or a mutable decl-ref redirects storage.
+      bool Mutable = !ConstDecl && !G.isConstant();
+      SmallVector<Use *, 8> Esc;
+      for (Use &U : G.uses()) {
+        auto *I = dyn_cast<Instruction>(U.getUser());
+        if (!I)
+          continue;
+        if (!Mutable && echoIsValueAccess(U))
+          continue; // const: only address escapes need canonicalising
+        StringRef PN = I->getFunction()->getName();
+        if (PN.starts_with("__echo") || PN.starts_with("thunk_") ||
+            PN.starts_with("echo_"))
+          continue; // runtime glue keeps the native address
+        Esc.push_back(&U);
+      }
+      if (Esc.empty())
+        continue;
+      auto *Slot = cast<GlobalVariable>(
+          M.getOrInsertGlobal(("__echo_var$" + G.getName()).str(), PtrTy));
+      if (!Slot->hasInitializer()) {
+        Slot->setInitializer(NullP);
+        Slot->setLinkage(GlobalValue::LinkOnceODRLinkage);
+      }
+      for (Use *U : Esc) {
+        auto *I = cast<Instruction>(U->getUser());
+        Instruction *IP =
+            isa<PHINode>(I)
+                ? cast<PHINode>(I)->getIncomingBlock(*U)->getTerminator()
+                : I;
+        IRBuilder<> B(IP);
+        Value *L = B.CreateLoad(PtrTy, Slot);
+        U->set(B.CreateSelect(B.CreateICmpEQ(L, NullP), &G, L));
+      }
+      Changed = true;
+    }
+  }
+
+  // docs/07 §5 three-phase mutable init. A synced MUTABLE global is initialised TWICE:
+  // here in the native module (during the host dlopen inside echoBootstrap -- BEFORE this
+  // library's face has published its slots, so the write lands in the NATIVE copy), and
+  // again by the face's own x86 static init (into the FACE copy, which is canonical).
+  // Without a third step the native world's initialised value would be lost the moment
+  // canonical flipped. So emit a per-module table of {slot, &G, sizeof G}; the face's last
+  // constructor triggers echo_commit_mutinit(), which copies native -> face once per
+  // table. The registering constructor runs at priority 101, i.e. BEFORE this module's own
+  // static initialisers, and also pulls every already-published slot value into this
+  // module's slot copies -- a module that loads AFTER another library published (native
+  // QtGui loads after face QtCore's publish) would otherwise run its static initialisers
+  // against the stale native copy of that library's globals.
+  {
+    const DataLayout &DL = M.getDataLayout();
+    Type *I64 = Type::getInt64Ty(C);
+    StructType *MITy = StructType::get(C, {PtrTy, PtrTy, I64});
+    auto *MNull = ConstantPointerNull::get(cast<PointerType>(PtrTy));
+    SmallVector<Constant *, 16> MIs;
+    bool AnySlot = false;
+    for (GlobalVariable &G : M.globals()) {
+      if (G.getName().starts_with("__echo_var$"))
+        AnySlot = true;
+      if (!isEchoSyncableVar(G) || G.isConstant())
+        continue; // const globals share identical bytes: nothing to carry over
+      auto *Slot = cast<GlobalVariable>(
+          M.getOrInsertGlobal(("__echo_var$" + G.getName()).str(), PtrTy));
+      if (!Slot->hasInitializer()) {
+        Slot->setInitializer(MNull);
+        Slot->setLinkage(GlobalValue::LinkOnceODRLinkage);
+      }
+      MIs.push_back(ConstantStruct::get(
+          MITy, {Slot, &G,
+                 ConstantInt::get(I64, DL.getTypeStoreSize(G.getValueType()))}));
+    }
+    if (!MIs.empty() || AnySlot) {
+      Constant *TabArg = MNull;
+      GlobalVariable *Tab = nullptr;
+      if (!MIs.empty()) {
+        auto *ArrTy = ArrayType::get(MITy, MIs.size());
+        Tab = new GlobalVariable(M, ArrTy, /*isConstant=*/true,
+                                 GlobalValue::InternalLinkage,
+                                 ConstantArray::get(ArrTy, MIs), "echo_mutinit_tab");
+        TabArg = Tab;
+      }
+      FunctionCallee Reg = M.getOrInsertFunction(
+          "__echo_register_mutinit",
+          FunctionType::get(Type::getVoidTy(C), {PtrTy, Type::getInt32Ty(C)}, false));
+      Function *Ctor = Function::Create(FunctionType::get(Type::getVoidTy(C), false),
+                                        GlobalValue::InternalLinkage,
+                                        "echo_mutinit_ctor", &M);
+      IRBuilder<> B(BasicBlock::Create(C, "entry", Ctor));
+      B.CreateCall(Reg, {TabArg, B.getInt32(MIs.size())});
+      B.CreateRetVoid();
+      appendToGlobalCtors(M, Ctor, 101);
+      if (Tab) {
+        // Drop the table before this DSO unmaps, so a later commit cannot walk it.
+        FunctionCallee Unreg = M.getOrInsertFunction(
+            "__echo_unregister_mutinit",
+            FunctionType::get(Type::getVoidTy(C), {PtrTy}, false));
+        Function *Dtor = Function::Create(FunctionType::get(Type::getVoidTy(C), false),
+                                          GlobalValue::InternalLinkage,
+                                          "echo_mutinit_dtor", &M);
+        IRBuilder<> DB(BasicBlock::Create(C, "entry", Dtor));
+        DB.CreateCall(Unreg, {Tab});
+        DB.CreateRetVoid();
+        appendToGlobalDtors(M, Dtor, 101);
+      }
+      Changed = true;
+    }
+  }
+
+  // docs/07 §6 deep-home: emit runtime back-fill descriptors for exported const objects
+  // (QMetaObject SMOs) whose pointer fields target internal relocation-free data blobs
+  // (qt_meta_data / stringdata). Each descriptor names the __echo_var$G slot (holds the
+  // FACE copy after publish), the field's byte offset, and THIS module's NATIVE blob. A
+  // load-time ctor registers them; echo_apply_smo_patches (run at the publish handshake)
+  // writes native_blob into face_G+offset, so both worlds' SMO fields point at the one
+  // (native) blob and the QMetaMethod.data.d identities agree.
+  {
+    const DataLayout &DL = M.getDataLayout();
+    Type *I64 = Type::getInt64Ty(C);
+    // {a, off, b, kind}. kind 0 (SMO/native-home): *(*a + off) = b -- a is the
+    // __echo_var$G slot (face copy), b the native blob/function. kind 1 (face-home):
+    // *(a + off) = *b -- a is THIS module's (possibly local) global, b the
+    // __echo_faceaddr$F slot (the face stub, filled at publish).
+    StructType *DescTy = StructType::get(C, {PtrTy, I64, PtrTy, I64});
+    auto *DNull = ConstantPointerNull::get(cast<PointerType>(PtrTy));
+    Constant *K0 = ConstantInt::get(I64, 0), *K1 = ConstantInt::get(I64, 1);
+    SmallVector<Constant *, 16> Descs;
+    for (GlobalVariable &G : M.globals()) {
+      if (!isEchoSyncableVar(G))
+        continue; // exported const with a __echo_var$G slot (address homed to face)
+      SmallVector<std::pair<uint64_t, GlobalVariable *>, 4> DataF;
+      SmallVector<std::pair<uint64_t, Function *>, 2> FuncF;
+      echoCollectDeepHomeFields(DL, G.getInitializer(), 0, DataF, FuncF);
+      if (DataF.empty())
+        continue; // not an SMO-shaped object (no internal data blob to home)
+      auto *Slot = cast<GlobalVariable>(
+          M.getOrInsertGlobal(("__echo_var$" + G.getName()).str(), PtrTy));
+      if (!Slot->hasInitializer()) {
+        Slot->setInitializer(DNull);
+        Slot->setLinkage(GlobalValue::LinkOnceODRLinkage);
+      }
+      for (auto &Fld : DataF)
+        Descs.push_back(ConstantStruct::get(
+            DescTy, {Slot, ConstantInt::get(I64, Fld.first), Fld.second, K0}));
+      // static_metacall: home to the NATIVE function only for a QMetaObject (the only
+      // exported const object whose static_metacall a host caller invokes on a face copy
+      // it received from the guest). Gate by type name so other callback-bearing const
+      // structs keep their face pointers.
+      auto *ST = dyn_cast<StructType>(G.getValueType());
+      if (ST && ST->hasName() && ST->getName().contains("QMetaObject"))
+        for (auto &Fld : FuncF)
+          Descs.push_back(ConstantStruct::get(
+              DescTy, {Slot, ConstantInt::get(I64, Fld.first), Fld.second, K0}));
+    }
+    // Face-home a binding-interface table's function fields: back-fill each with the
+    // face stub address (from __echo_faceaddr$F) so the guest, which reads THIS native
+    // (local) table via bindableXxx(), gets a guest-invokable pointer. A host reader now
+    // sees the face stub too and routes through the dispatcher on call.
+    for (GlobalVariable &G : M.globals()) {
+      if (!echoIsBindingIfaceGlobal(G))
+        continue;
+      SmallVector<std::pair<uint64_t, Function *>, 8> Fields;
+      echoCollectIfaceFuncFields(DL, G.getInitializer(), 0, Fields);
+      for (auto &Fld : Fields) {
+        // An EXPORTED field is homed too. Skipping it assumed the guest would read the
+        // FACE's copy of the table, where the field already holds a face stub. It does
+        // not: a getter hands back the address of the NATIVE table, and the guest walks
+        // that one. OpenSSL's EC_GFp_simple_method() returns &ret, its own static const
+        // EC_METHOD, and every entry in it is an export, so the whole table went unhomed
+        // and a guest calling group->meth->field_mul jumped straight into native code.
+        // The face publishes __echo_faceaddr$F for an export exactly as for anything
+        // else, so the back-fill has always had an address to use.
+        //
+        // The slot name must carry the module hash for an internal function, exactly
+        // as an escaping-by-value one does. pixman compiles pixman-access.c twice --
+        // once plainly and once through pixman-access-accessors.c, which #includes it
+        // with PIXMAN_FB_ACCESSORS -- so both objects define a static
+        // fetch_pixel_a2r10g10b10_float and a static const accessors[] table pointing
+        // at it. With a bare slot name the two share one slot, the plain table gets
+        // back-filled with the accessors variant's stub, and that variant dereferences
+        // image->read_func, which is null unless the caller set an accessor.
+        auto *FA = cast<GlobalVariable>(
+            M.getOrInsertGlobal(echoFaceAddrSlotName(M, *Fld.second), PtrTy));
+        if (!FA->hasInitializer()) {
+          FA->setInitializer(DNull);
+          FA->setLinkage(GlobalValue::LinkOnceODRLinkage);
+        }
+        Descs.push_back(ConstantStruct::get(
+            DescTy, {&G, ConstantInt::get(I64, Fld.first), FA, K1}));
+      }
+    }
+    if (!Descs.empty()) {
+      auto *ArrTy = ArrayType::get(DescTy, Descs.size());
+      auto *Arr = new GlobalVariable(M, ArrTy, /*isConstant=*/true,
+                                     GlobalValue::InternalLinkage,
+                                     ConstantArray::get(ArrTy, Descs),
+                                     "echo_smo_patch_tab");
+      FunctionCallee Reg = M.getOrInsertFunction(
+          "__echo_register_smo_patches",
+          FunctionType::get(Type::getVoidTy(C), {PtrTy, Type::getInt32Ty(C)}, false));
+      Function *Ctor = Function::Create(FunctionType::get(Type::getVoidTy(C), false),
+                                        GlobalValue::InternalLinkage,
+                                        "echo_smo_patch_ctor", &M);
+      IRBuilder<> B(BasicBlock::Create(C, "entry", Ctor));
+      B.CreateCall(Reg, {Arr, B.getInt32(Descs.size())});
+      B.CreateRetVoid();
+      appendToGlobalCtors(M, Ctor, 65535);
+
+      // The runtime keeps the descriptor-table pointer so later face publishes can
+      // re-apply patches. Remove it while this DSO's storage is still mapped; otherwise
+      // a later dlopen/publish would walk a dangling pointer after dlclose.
+      FunctionCallee Unreg = M.getOrInsertFunction(
+          "__echo_unregister_smo_patches",
+          FunctionType::get(Type::getVoidTy(C), {PtrTy}, false));
+      Function *Dtor = Function::Create(FunctionType::get(Type::getVoidTy(C), false),
+                                        GlobalValue::InternalLinkage,
+                                        "echo_smo_patch_dtor", &M);
+      IRBuilder<> DB(BasicBlock::Create(C, "entry", Dtor));
+      DB.CreateCall(Unreg, {Arr});
+      DB.CreateRetVoid();
+      appendToGlobalDtors(M, Dtor, 65535);
+      Changed = true;
+    }
+  }
+
+  for (Function *F : Worklist) {
+    std::string TN = (Twine("thunk_") + F->getName()).str();
+    if (M.getNamedValue(TN))
+      continue; // a hand-written/previous thunk already exists
+
+    // A no-key-function vtable virtual (collected above) is linkonce_odr, emitted
+    // in every TU that references the vtable; give its thunk the same weak+comdat
+    // linkage so multiple TUs of one library don't collide on a strong thunk_ def.
+    // Key-function exports keep external linkage (one strong definition per program).
+    bool WeakBody = !F->hasExternalLinkage();
+    Function *Thunk = Function::Create(
+        ThunkTy,
+        WeakBody ? GlobalValue::LinkOnceODRLinkage : GlobalValue::ExternalLinkage,
+        TN, &M);
+    Thunk->setVisibility(GlobalValue::DefaultVisibility);
+    if (WeakBody)
+      Thunk->setComdat(M.getOrInsertComdat(TN));
+
+    IRBuilder<> B(BasicBlock::Create(C, "entry", Thunk));
+    Value *Blk = Thunk->getArg(0);
+
+    // Variadic (03-varargs): a `...` function or a va_list function. The face
+    // captured the variadic tail into a boxed CVargEntry[] (blk->varargs) and put
+    // the fixed args in blk->argblock. If Echo recognised the printf/scanf family
+    // it replays with the BUILT-IN echo_varg_call (a `...`-shaped target, boxes
+    // spread positionally) / echo_varg_vcall (a va_list-shaped target, boxes
+    // rebuilt into a real native va_list); otherwise it calls the user's registered
+    // replay op (__echo_vaops_<neutral>.replay, a WEAK reference that aborts if a
+    // caller crosses without one). The result returns in a CVargEntry (value @8).
+    if (F->isVarArg() || shouldVaListThunk(*F)) {
+      Type *I32Ty = Type::getInt32Ty(C);
+      Type *VoidTy = Type::getVoidTy(C);
+      bool Valist = !F->isVarArg();
+      EchoVaFmt VF = echoPrintfFamily(*F);
+      unsigned NFixed = Valist ? F->arg_size() - 1 : F->arg_size();
+      Value *Named = B.CreateLoad(
+          PtrTy, B.CreateGEP(I8Ty, Blk, {B.getInt64(EchoArgblockOff)}));
+      Value *Cv = B.CreateLoad(
+          PtrTy, B.CreateGEP(I8Ty, Blk, {B.getInt64(EchoVarargsOff)}));
+      Type *RetTy = F->getReturnType();
+      Value *CvRet = B.CreateAlloca(ArrayType::get(I8Ty, EchoCVargSize));
+      cast<AllocaInst>(CvRet)->setAlignment(Align(EchoSlot));
+      B.CreateMemSet(CvRet, B.getInt8(0), B.getInt64(EchoCVargSize),
+                     Align(EchoSlot));
+      B.CreateStore(B.getInt32(echoCVargTag(RetTy)), CvRet); // ret width for replay
+      if (VF.Match) {
+        // Built-in: box the fixed args from the named struct, then echo_varg_call
+        // (`...` target) / echo_varg_vcall (va_list target).
+        SmallVector<Type *, 8> NF;
+        for (unsigned I = 0; I < NFixed; ++I)
+          NF.push_back(F->getArg(I)->getType());
+        StructType *NamedTy = StructType::get(C, NF);
+        Value *Argv1 = B.CreateAlloca(
+            ArrayType::get(I8Ty, (NFixed ? NFixed : 1) * EchoCVargSize));
+        cast<AllocaInst>(Argv1)->setAlignment(Align(EchoSlot));
+        for (unsigned I = 0; I < NFixed; ++I) {
+          Value *Fld = B.CreateLoad(NF[I], B.CreateStructGEP(NamedTy, Named, I));
+          Value *Slot = B.CreateGEP(
+              I8Ty, Argv1, {B.getInt64((uint64_t)I * EchoCVargSize)});
+          echoBoxValue(B, Slot, Fld, NF[I], I8Ty);
+        }
+        int Sret = echoSretArg(*F);
+        if (Sret == 0) {
+          // By-value AGGREGATE return via a hidden sret pointer (F's arg 0, boxed at
+          // argv1[0]; the IR return type is void). libffi routes that buffer through
+          // the sret register (x8 on aarch64, rdi on x86_64) natively, so the same
+          // path works on every arch -- for a `...` target (echo_varg_call_sret, tail
+          // spread positionally) and a va_list target (echo_varg_vcall_sret, va_list
+          // reconstructed). F writes its result straight into the caller's buffer.
+          Type *I64Ty = Type::getInt64Ty(C);
+          uint64_t Sz = M.getDataLayout().getTypeAllocSize(
+              F->getArg(0)->getParamStructRetType());
+          FunctionCallee Replay = M.getOrInsertFunction(
+              Valist ? "echo_varg_vcall_sret" : "echo_varg_call_sret",
+              FunctionType::get(VoidTy, {PtrTy, I32Ty, PtrTy, I32Ty, PtrTy, I64Ty},
+                                false));
+          B.CreateCall(Replay, {F, B.getInt32(NFixed), Argv1, B.getInt32(-1), Cv,
+                                B.getInt64(Sz)});
+        } else {
+          FunctionCallee Replay = M.getOrInsertFunction(
+              Valist ? "echo_varg_vcall" : "echo_varg_call",
+              FunctionType::get(VoidTy, {PtrTy, I32Ty, PtrTy, I32Ty, PtrTy, PtrTy},
+                                false));
+          B.CreateCall(Replay, {F, B.getInt32(NFixed), Argv1, B.getInt32(-1), Cv,
+                                CvRet});
+        }
+      } else {
+        // User replay op: __echo_vaops_<neutral>.replay(F, named, cvbuf, cvret).
+        StructType *OpsTy = StructType::get(C, {PtrTy, PtrTy});
+        Constant *Ops = echoVaopsRef(M, echoNeutralName(*F), OpsTy);
+        echoVaopsGuard(M, B, Ops, Thunk, F->getName());
+        Value *Rep = B.CreateLoad(
+            PtrTy, B.CreateInBoundsGEP(OpsTy, Ops,
+                                       {B.getInt64(0), B.getInt32(1)}));
+        FunctionType *RepTy = FunctionType::get(
+            VoidTy, {PtrTy, PtrTy, PtrTy, PtrTy}, false);
+        B.CreateCall(RepTy, Rep, {F, Named, Cv, CvRet});
+      }
+      if (!RetTy->isVoidTy()) {
+        Value *Ret = B.CreateLoad(
+            PtrTy, B.CreateGEP(I8Ty, Blk, {B.getInt64(EchoRetOff)}));
+        Value *Val = B.CreateAlignedLoad(
+            RetTy, B.CreateGEP(I8Ty, CvRet, {B.getInt64(EchoCVargValueOff)}),
+            Align(EchoSlot));
+        B.CreateAlignedStore(Val, Ret, Align(1));
+      }
+      B.CreateRetVoid();
+      Changed = true;
+      continue;
+    }
+
+    // argblock = *(void **)((char *)b + 16)   (block is 8-aligned)
+    Value *Ab = B.CreateLoad(
+        PtrTy, B.CreateGEP(I8Ty, Blk, {B.getInt64(EchoArgblockOff)}));
+
+    // unpack each argument from its argblock slot (01-abi-spec §3). A byval(T)
+    // parameter is rebuilt into a properly-aligned copy passed byval; every other
+    // parameter is loaded as its value. The call inherits F's attribute list, so
+    // byval/sret/ext attributes are placed on the matching operands.
+    const DataLayout &DL = M.getDataLayout();
+    SmallVector<EchoSlotInfo, 8> Slots;
+    echoArgLayout(*F, DL, Slots);
+    SmallVector<Value *, 8> Args;
+    unsigned Idx = 0;
+    for (Argument &A : F->args()) {
+      const EchoSlotInfo &S = Slots[Idx++];
+      Value *Slot = B.CreateGEP(I8Ty, Ab, {B.getInt64(S.Off)});
+      if (S.ByvalTy) {
+        Align BvAl = A.getParamAlign().valueOrOne();
+        Value *Tmp = B.CreateAlloca(S.ByvalTy);
+        cast<AllocaInst>(Tmp)->setAlignment(BvAl);
+        B.CreateMemCpy(Tmp, BvAl, Slot, Align(8), B.getInt64(S.Size));
+        Args.push_back(Tmp);
+      } else {
+        Args.push_back(B.CreateAlignedLoad(A.getType(), Slot, Align(8)));
+      }
+    }
+
+    // C-3 (docs/20 §7): a function that can throw is invoked; on unwind a
+    // catch-all landingpad tags the exception into EchoException and marks the
+    // block pending (the typed catch lives in the runtime __echo_catch_current).
+    Value *Res;
+    if (F->doesNotThrow()) {
+      Res = B.CreateCall(F->getFunctionType(), F, Args);
+    } else {
+      Type *I32Ty = Type::getInt32Ty(C);
+      Type *VoidTy = Type::getVoidTy(C);
+      Thunk->setPersonalityFn(cast<Constant>(
+          M.getOrInsertFunction("__gxx_personality_v0",
+                                FunctionType::get(I32Ty, true))
+              .getCallee()));
+      BasicBlock *Cont = BasicBlock::Create(C, "cont", Thunk);
+      BasicBlock *Lpad = BasicBlock::Create(C, "lpad", Thunk);
+      Res = B.CreateInvoke(F->getFunctionType(), F, Cont, Lpad, Args);
+
+      IRBuilder<> LB(Lpad);
+      LandingPadInst *LP =
+          LB.CreateLandingPad(StructType::get(C, {PtrTy, I32Ty}), 0);
+      LP->addClause(ConstantPointerNull::get(cast<PointerType>(PtrTy)));
+      // __cxa_begin_catch returns the in-flight exception object; hand it to the
+      // runtime so it can copy-construct a faithful copy (Tier-2), keyed by the
+      // current exception type (see HostRT/Catch.cpp).
+      Value *ExcObj = LB.CreateCall(
+          M.getOrInsertFunction("__cxa_begin_catch",
+                                FunctionType::get(PtrTy, {PtrTy}, false)),
+          {LB.CreateExtractValue(LP, 0)});
+      LB.CreateCall(M.getOrInsertFunction(
+                        "__echo_catch_current",
+                        FunctionType::get(VoidTy, {PtrTy, PtrTy}, false)),
+                    {Blk, ExcObj});
+      LB.CreateCall(M.getOrInsertFunction(
+          "__cxa_end_catch", FunctionType::get(VoidTy, false)));
+      LB.CreateRetVoid();
+
+      B.SetInsertPoint(Cont);
+    }
+    // Propagate F's byval/sret/ext operand attributes onto the call so the
+    // backend places aggregates per the SysV ABI.
+    cast<CallBase>(Res)->setAttributes(F->getAttributes());
+
+    if (!F->getReturnType()->isVoidTy()) {
+      Value *Ret =
+          B.CreateLoad(PtrTy, B.CreateGEP(I8Ty, Blk, {B.getInt64(EchoRetOff)}));
+      B.CreateAlignedStore(Res, Ret, Align(1));
+    }
+    B.CreateRetVoid();
+    Changed = true;
+  }
+
+  // B-3a: emit __echo_publish_<srchash>(EchoPublish*). One cross fills this module's
+  // binding table in guest memory BY NAME: the guest hands a neutral-name list, and
+  // this side matches its own directory against it (docs/19 §6b). The symbol suffix
+  // is the SOURCE hash (arch-invariant), so the face — even when arch-#ifdef code
+  // makes its worklist differ from ours — resolves this exact module's publisher;
+  // name matching then binds the common functions and leaves each side's extras
+  // unbound. host_version still carries the worklist hash as a soft diagnostic.
+  uint64_t PubHash = echoSourceHash(M);
+  std::string PubName = ("__echo_publish_" + Twine::utohexstr(PubHash)).str();
+  if (!Worklist.empty() && !M.getNamedValue(PubName)) {
+    Type *I32Ty = Type::getInt32Ty(C);
+    Function *Pub = Function::Create(
+        FunctionType::get(Type::getVoidTy(C), {PtrTy}, false),
+        GlobalValue::ExternalLinkage, PubName, &M);
+    Pub->setVisibility(GlobalValue::DefaultVisibility);
+    IRBuilder<> B(BasicBlock::Create(C, "entry", Pub));
+
+    // Native directory: [{ neutral_name, native_target, thunk } ...], one per bound
+    // function, in Worklist order (already sorted by neutral name). Built with DIRECT
+    // references to this module's functions + thunks, so it covers functions the
+    // linker keeps local/hidden (which the guest could not dlsym).
+    StructType *DirEntTy = StructType::get(C, {PtrTy, PtrTy, PtrTy});
+    SmallVector<Constant *, 16> DirEnts;
+    for (Function *F : Worklist) {
+      auto *Thunk = dyn_cast_or_null<Constant>(
+          M.getNamedValue((Twine("thunk_") + F->getName()).str()));
+      if (!Thunk)
+        continue;
+      Constant *NameC = B.CreateGlobalString(echoNeutralName(*F));
+      DirEnts.push_back(ConstantStruct::get(DirEntTy, {NameC, F, Thunk}));
+    }
+    auto *DirTy = ArrayType::get(DirEntTy, DirEnts.size());
+    auto *Dir = new GlobalVariable(
+        M, DirTy, /*isConstant=*/true, GlobalValue::InternalLinkage,
+        ConstantArray::get(DirTy, DirEnts), "echo_natdir_" + Twine::utohexstr(PubHash));
+
+    Value *P = Pub->getArg(0);
+    Value *Table = B.CreateLoad(
+        PtrTy, B.CreateGEP(I8Ty, P, {B.getInt64(EchoPublishTableOff)}));
+    Value *Count = B.CreateLoad(
+        I32Ty, B.CreateGEP(I8Ty, P, {B.getInt64(EchoPublishCountOff)}));
+    Value *Names = B.CreateLoad(
+        PtrTy, B.CreateGEP(I8Ty, P, {B.getInt64(EchoPublishNamesOff)}));
+    // __echo_bind_match(table, count, names, echo_natdir, ndir)
+    FunctionCallee Match = M.getOrInsertFunction(
+        "__echo_bind_match",
+        FunctionType::get(Type::getVoidTy(C), {PtrTy, I32Ty, PtrTy, PtrTy, I32Ty},
+                          false));
+    B.CreateCall(Match, {Table, Count, Names, Dir, B.getInt32(DirEnts.size())});
+    // p->host_version = this side's worklist hash (soft diagnostic only)
+    B.CreateAlignedStore(
+        B.getInt64(echoVersionHash(Worklist)),
+        B.CreateGEP(I8Ty, P, {B.getInt64(EchoPublishVersionOff)}), Align(EchoSlot));
+    B.CreateRetVoid();
+    Changed = true;
+  }
+
+  // D-3 + R-2: route every native indirect/virtual call. A supported signature
+  // (call instr) goes through its echo_dispatch_<key>, which translates a face
+  // stub to the native body AND reenters the guest when the target is guest code
+  // (docs/23 §2.6). Unsupported signatures and invokes keep the old translate-
+  // only wrap via __echo_check_call. Direct calls are untouched.
+  FunctionCallee CheckCall = M.getOrInsertFunction(
+      "__echo_check_call", FunctionType::get(PtrTy, {PtrTy}, false));
+  SmallVector<CallBase *, 16> Indirect;
+  for (Function &Fn : M) {
+    if (Fn.isDeclaration() || Fn.getName().starts_with("__echo") ||
+        Fn.getName().starts_with("echo_dispatch_"))
+      continue;
+    for (BasicBlock &BB : Fn)
+      for (Instruction &I : BB)
+        if (auto *CB = dyn_cast<CallBase>(&I))
+          if (CB->isIndirectCall())
+            Indirect.push_back(CB);
+  }
+  for (CallBase *CB : Indirect) {
+    FunctionType *FT = echoCallSiteFT(CB);
+    // A supported-signature call OR invoke routes through the per-signature host
+    // dispatcher, which translates a face stub to the native body and reenters the
+    // guest when the target is guest code. Invokes (an indirect call that can
+    // unwind -- e.g. Qt's doActivate calls a slot under a scope guard with
+    // exceptions on) keep their landingpad, so the non-throwing path reenters
+    // normally. (Propagating a guest-thrown exception back across the reentry is a
+    // separate step; here the guest slot returns normally.)
+    AttributeList AL0 = CB->getAttributes();
+    Function *Disp0 = (echoSigSupported(FT, M.getDataLayout()) &&
+                       (isa<CallInst>(CB) || isa<InvokeInst>(CB)))
+                          ? echoGetDispatch(M, FT, AL0)
+                          : nullptr;
+    // Disp0 == null also covers the rare canonical-key collision (two coerced aggregate
+    // return types sharing one key in this module): fall back to translate-only.
+    if (Disp0) {
+      AttributeList AL = AL0;
+      Function *Disp = Disp0;
+      IRBuilder<> B(CB);
+      SmallVector<Value *, 8> Args;
+      Args.push_back(CB->getCalledOperand());
+      for (Value *A : CB->args())
+        Args.push_back(A);
+      CallBase *NC;
+      if (auto *II = dyn_cast<InvokeInst>(CB))
+        NC = B.CreateInvoke(Disp->getFunctionType(), Disp, II->getNormalDest(),
+                            II->getUnwindDest(), Args);
+      else
+        NC = B.CreateCall(Disp->getFunctionType(), Disp, Args);
+      // Carry the callee's ABI attrs (shifted past the prepended fp) so the sret
+      // pointer / byval aggregate reach the dispatcher in the right registers.
+      NC->setAttributes(echoShiftAttrs(M.getContext(), AL, FT->getNumParams()));
+      Value *Repl = NC;
+      Type *RealRet = FT->getReturnType();
+      if (!RealRet->isVoidTy() && NC->getType() != RealRet) {
+        // The dispatcher handed back the canonical carrier; turn it into this call
+        // site's own coerced type. Through memory, so no register-class assumption --
+        // and the alloca lives in the entry block, since this call may sit in a loop.
+        Function *PF = NC->getFunction();
+        IRBuilder<> EB(&*PF->getEntryBlock().getFirstInsertionPt());
+        Value *Tmp = EB.CreateAlloca(NC->getType());
+        cast<AllocaInst>(Tmp)->setAlignment(Align(16));
+        if (auto *NI = dyn_cast<InvokeInst>(NC)) {
+          // An invoke's result is only live on its normal edge, and a PHI in that
+          // destination may use it -- a load placed there would not dominate the PHI.
+          // Splice a conversion block into the edge instead.
+          BasicBlock *Norm = NI->getNormalDest();
+          BasicBlock *Conv =
+              BasicBlock::Create(M.getContext(), "echo.retconv", PF, Norm);
+          NI->setNormalDest(Conv);
+          for (PHINode &P : Norm->phis()) {
+            int Idx = P.getBasicBlockIndex(NI->getParent());
+            if (Idx >= 0)
+              P.setIncomingBlock((unsigned) Idx, Conv);
+          }
+          IRBuilder<> CvB(Conv);
+          CvB.CreateAlignedStore(NC, Tmp, Align(16));
+          Repl = CvB.CreateAlignedLoad(RealRet, Tmp, Align(16));
+          CvB.CreateBr(Norm);
+        } else {
+          IRBuilder<> CvB(CB); // just before the call we are about to erase
+          CvB.CreateAlignedStore(NC, Tmp, Align(16));
+          Repl = CvB.CreateAlignedLoad(RealRet, Tmp, Align(16));
+        }
+      }
+      CB->replaceAllUsesWith(Repl);
+      CB->eraseFromParent();
+    } else {
+      // translate-only fallback (aggregate sig / varargs).
+      IRBuilder<> B(CB);
+      Value *Real = B.CreateCall(CheckCall, {CB->getCalledOperand()});
+      CB->setCalledOperand(Real);
+    }
+    Changed = true;
+  }
+
+  return Changed;
+}
+
+// B-2: replace each exported leaf body F in-place with the face stub that packs
+// F's arguments into an EchoCallBlock and crosses; synthesize the echo_bind
+// table and __echo_gen_resolve. The native body + thunk_F live in the *other*
+// object (default mode). Equivalent to the prototype's facegen face_stubs.c +
+// face_resolve.c. See x64echo docs/19 §6a.
+/// Drop the translation unit's own static constructors from a FACE module, keeping only
+/// the ones Echo itself emitted (echo_mutinit_ctor, echo_smo_patch_ctor, ...).
+///
+/// A face is a SHADOW of one library, not a second copy of it. The native half runs the
+/// library's static initialisers; running them again on the face performs every one of
+/// them TWICE, because a face body is a stub that crosses into the very same native code.
+/// Duplicated *storage* is already reconciled -- docs/07 §5 copies the native value over
+/// the face copy -- but a duplicated *side effect* cannot be: an initialiser that
+/// registers into a process-wide registry registers twice. Qt's QML module registration
+/// makes that fatal (qFatal "Cannot add multiple registrations for QtQml"); a registry
+/// that merely counted would double silently, which is worse.
+///
+/// The face's copies of dynamically-initialised globals stay zero until
+/// echo_commit_mutinit fills them from the native ones. Nothing reads them before that:
+/// every face function body is a stub, so only native code runs the library's own logic.
+///
+/// ECHO_KEEP_FACE_CTORS=1 restores the old behaviour, for bisecting against this change.
+static void echoStripFaceSourceCtors(Module &M) {
+  if (getenv("ECHO_KEEP_FACE_CTORS"))
+    return;
+  auto *GV = M.getGlobalVariable("llvm.global_ctors");
+  if (!GV || !GV->hasInitializer())
+    return;
+  auto *Init = dyn_cast<ConstantArray>(GV->getInitializer());
+  if (!Init)
+    return;
+
+  SmallVector<Constant *, 8> Keep;
+  for (unsigned I = 0, N = Init->getNumOperands(); I != N; ++I) {
+    auto *E = cast<ConstantStruct>(Init->getOperand(I));
+    auto *F = dyn_cast<Function>(E->getOperand(1)->stripPointerCasts());
+    /// Keep Echo's own machinery; a null entry is kept too (it is not ours to judge).
+    if (!F || F->getName().starts_with("echo_") || F->getName().starts_with("__echo"))
+      Keep.push_back(E);
+  }
+  if (Keep.size() == Init->getNumOperands())
+    return;
+
+  Type *ETy = Init->getType()->getElementType();
+  StringRef Sec = GV->getSection();
+  GV->eraseFromParent();
+  if (Keep.empty())
+    return;
+  auto *ATy = ArrayType::get(ETy, Keep.size());
+  auto *NG = new GlobalVariable(M, ATy, /*isConstant=*/false,
+                                GlobalValue::AppendingLinkage,
+                                ConstantArray::get(ATy, Keep), "llvm.global_ctors");
+  NG->setSection(Sec);
+}
+
+static bool runFace(Module &M) {
+  LLVMContext &C = M.getContext();
+  Type *VoidTy = Type::getVoidTy(C);
+  Type *PtrTy = PointerType::getUnqual(C);
+  Type *I8Ty = Type::getInt8Ty(C);
+  Type *I64Ty = Type::getInt64Ty(C);
+
+  SmallVector<Function *, 16> Worklist;
+  for (Function &F : M)
+    if (isEchoExport(F))
+      Worklist.push_back(&F);
+  echoCollectVtableFns(M, Worklist);
+  echoCollectEscapingFns(M, Worklist);
+  // Before the sort: both halves order the worklist identically and the publish handshake
+  // depends on that agreement, so anything added afterwards would desynchronise them.
+  echoCollectInternalEscapers(M, Worklist);
+  // Sort by name so the binding-slot layout and version hash are arch-invariant:
+  // the face (x86) and native (e.g. aarch64) compile the same source under
+  // different target pipelines, which can leave M's function order differing, and
+  // the publish handshake keys on both halves agreeing exactly (docs/19 §6b).
+  llvm::sort(Worklist, [](const Function *A, const Function *B) {
+    return echoNeutralName(*A) < echoNeutralName(*B);
+  });
+  echoDumpWorklist("face", M, Worklist);
+  if (Worklist.empty())
+    return false;
+
+  // R-2 (docs/23 §2.5): before the bodies are erased into stubs, scan the host
+  // function bodies for indirect call sites; for each distinct supported
+  // signature emit the guest-side echo_redispatch_<key>. These are reverse-
+  // published (below) so the native echo_dispatch_<key> finds the dispatcher to
+  // run on a host->guest reentry. face & native see the same call sites.
+  SmallVector<Function *, 8> Redispatchers;
+  for (Function &F : M) {
+    if (F.isDeclaration())
+      continue;
+    for (BasicBlock &BB : F)
+      for (Instruction &I : BB)
+        // CallBase covers both call and INVOKE: a virtual reentry call inside a
+        // host try/catch is an indirect invoke (exception-across-reentry), and it
+        // needs a redispatcher just as a plain indirect call does.
+        if (auto *CI = dyn_cast<CallBase>(&I))
+          if (CI->isIndirectCall() &&
+              echoSigSupported(echoCallSiteFT(CI), M.getDataLayout())) {
+            Function *RD =
+                echoGetRedispatch(M, echoCallSiteFT(CI), CI->getAttributes());
+            if (!llvm::is_contained(Redispatchers, RD))
+              Redispatchers.push_back(RD);
+          }
+  }
+
+  // Also scan (before the bodies become stubs) for exported functions whose
+  // address escapes as a value: the native side redirects each such reference to
+  // __echo_faceaddr$F, and here we reverse-publish this face's stub address into
+  // that slot so the canonical pointer is the face one. Same classification as the
+  // native pass, so the slot names match. Record names now; capture each function's
+  // stub alias in the body-erase loop below (the Function itself is erased there).
+  StringSet<> EscapingNames;
+  for (Function *F : Worklist)
+    if (echoComparedAsValue(*F))
+      EscapingNames.insert(F->getName());
+  // Map a function name to the slot the native half will look for. Internal functions
+  // carry the module hash (echoFaceAddrSlotName), so the two halves must agree here too.
+  StringMap<std::string> EscapingSlot;
+  for (Function *F : Worklist)
+    if (echoComparedAsValue(*F))
+      EscapingSlot[F->getName()] = echoFaceAddrSlotName(M, *F);
+  // Internal escapers must be collected NOW, before the exported bodies are erased into
+  // stubs. The reference that makes an internal function escape usually lives inside an
+  // exported one -- lcms2 selects LinLerp1D inside DefaultInterpolatorsFactory -- so after
+  // the erase it has no users left and looks like it never escaped. Keeping them in
+  // llvm.used matters for the same reason: once the only reference is gone, an internal
+  // function with no uses is dead and would be deleted before it can be published.
+  // A binding-interface table's function fields are face-homed on the native side
+  // (the native table's field is back-filled to __echo_faceaddr$F); reverse-publish
+  // this face's stub address into that slot so the back-fill lands a real face stub.
+  {
+    const DataLayout &DL = M.getDataLayout();
+    for (GlobalVariable &G : M.globals()) {
+      if (!echoIsBindingIfaceGlobal(G))
+        continue;
+      SmallVector<std::pair<uint64_t, Function *>, 8> Fields;
+      echoCollectIfaceFuncFields(DL, G.getInitializer(), 0, Fields);
+      for (auto &Fld : Fields) {
+        // Exports included, mirroring the native half. The native side creates a slot
+        // for every field of the table; if this side publishes into only some of them,
+        // the rest stay null and the back-fill silently leaves the native address in
+        // place -- which is the whole failure, just moved one step later.
+        EscapingNames.insert(Fld.second->getName());
+        // Record the slot too. Without this the reverse-publish below falls back to
+        // the bare name while the native half now emits the hashed one, and the
+        // back-fill never lands.
+        EscapingSlot[Fld.second->getName()] =
+            echoFaceAddrSlotName(M, *Fld.second);
+      }
+    }
+  }
+  SmallVector<GlobalAlias *, 16> EscapingAliases;
+
+  // Exported globals: reverse-publish this face's copy address into the native
+  // __echo_var$G slot (see docs/07). A MUTABLE global is published unconditionally
+  // (the native side redirects ALL its accesses to the face storage, so it needs the
+  // address regardless of how the face itself uses it). A CONST global is published
+  // only if its address escapes into code here (mirrors the native side, which only
+  // canonicalises escaping uses). Scan before the bodies are erased (escaping uses
+  // live in them); the globals persist, so keep the GlobalVariable* to publish below.
+  SmallVector<GlobalVariable *, 16> SyncVars;
+  for (GlobalVariable &G : M.globals()) {
+    if (!isEchoSyncableVar(G))
+      continue;
+    if (!G.isConstant()) {
+      SyncVars.push_back(&G); // mutable: storage is shared, always publish
+      continue;
+    }
+    // A QMetaObject SMO is always published: in -echo-emit-face mode the class's
+    // metaObject()/qt_metacast bodies are self-stubs that no longer reference &SMO, so the
+    // escape scan below would miss it -- but the native side DOES read &SMO (its real
+    // metaObject() body) and needs the face copy in its __echo_var$ slot to reconcile a
+    // runtime-dlopen'd plugin's chain. Publishing an unreferenced SMO just fills a slot.
+    if (echoIsQMetaObjectSMO(G)) {
+      SyncVars.push_back(&G);
+      continue;
+    }
+    bool escapes = false;
+    for (Use &U : G.uses())
+      if (isa<Instruction>(U.getUser()) && !echoIsValueAccess(U)) {
+        escapes = true;
+        break;
+      }
+    if (escapes)
+      SyncVars.push_back(&G);
+  }
+
+  // echo_bind: [N x { native_target, entry_thunk }], zero-initialised, filled by
+  // __echo_gen_resolve at the bootstrap handshake (echo_call.h EchoBinding).
+  StructType *BindTy = StructType::get(C, {PtrTy, PtrTy});
+  ArrayType *BindArrTy = ArrayType::get(BindTy, Worklist.size());
+  auto *EchoBind = new GlobalVariable(
+      M, BindArrTy, /*isConstant=*/false, GlobalValue::InternalLinkage,
+      ConstantAggregateZero::get(BindArrTy), "echo_bind");
+  EchoBind->setAlignment(Align(EchoSlot));
+
+  // echo_bindnames: [N x i8*], the neutral name of each echo_bind slot in the same
+  // (name-sorted) order. Handed to the native publisher, which name-matches its own
+  // directory against it to fill echo_bind — so a face-only function (an x86-only
+  // class under #ifdef, absent from the native) simply never matches and its slot
+  // stays null, instead of the whole module aborting on a worklist-hash mismatch.
+  auto makeCStr = [&](StringRef S) -> Constant * {
+    Constant *Init = ConstantDataArray::getString(C, S, /*AddNull=*/true);
+    auto *GV = new GlobalVariable(M, Init->getType(), /*isConstant=*/true,
+                                  GlobalValue::PrivateLinkage, Init);
+    GV->setUnnamedAddr(GlobalValue::UnnamedAddr::Global);
+    return GV;
+  };
+  SmallVector<Constant *, 16> NameEnts;
+  for (Function *F : Worklist)
+    NameEnts.push_back(makeCStr(echoNeutralName(*F)));
+  auto *NamesArrTy = ArrayType::get(PtrTy, Worklist.size());
+  auto *EchoBindNames = new GlobalVariable(
+      M, NamesArrTy, /*isConstant=*/true, GlobalValue::InternalLinkage,
+      ConstantArray::get(NamesArrTy, NameEnts), "echo_bindnames");
+
+  // &echo_bind[Idx].<Field>   (Field 0 = native_target, 1 = entry_thunk)
+  auto bindFieldPtr = [&](IRBuilder<> &B, uint64_t Idx, unsigned Field) {
+    return B.CreateInBoundsGEP(
+        BindArrTy, EchoBind,
+        {B.getInt64(0), B.getInt64(Idx), B.getInt32(Field)});
+  };
+
+  FunctionCallee Cross = M.getOrInsertFunction(
+      "__echo_cross", FunctionType::get(VoidTy, {I64Ty, PtrTy}, false));
+
+  // Self-identifying stubs (docs/21 D-1). The version hash MUST be computed here,
+  // before the loop erases the original functions.
+  uint64_t Ver = echoVersionHash(Worklist);
+  unsigned NumStubs = Worklist.size();
+
+  // EchoStub: { [8 x i8] instr, ptr pack_target, ptr native_target, i64 magic }.
+  // instr = `jmp qword ptr [rip+2]` (ff 25 02 00 00 00) + 2 nop, which jumps
+  // through pack_target@8. native_target@16 stays 0 (handshake fills it; read by
+  // the host __echo_check_call). See docs/21 §2.
+  ArrayType *InstrTy = ArrayType::get(I8Ty, 8);
+  StructType *StubTy = StructType::get(C, {InstrTy, PtrTy, PtrTy, I64Ty});
+  const uint8_t InstrBytes[8] = {0xFF, 0x25, 0x02, 0x00, 0x00, 0x00, 0x90, 0x90};
+  Constant *InstrInit = ConstantDataArray::get(C, ArrayRef<uint8_t>(InstrBytes));
+  Constant *Magic = ConstantInt::get(I64Ty, EchoStubMagic);
+  Constant *NullP = ConstantPointerNull::get(cast<PointerType>(PtrTy));
+
+  for (uint64_t Idx = 0; Idx < Worklist.size(); ++Idx) {
+    Function *F = Worklist[Idx];
+    std::string Name = F->getName().str();
+
+    // Variadic (03-varargs): a `...` function or a va_list function. Rebuild F in
+    // place as a stub that packs its fixed args into a natural struct (= `named`),
+    // captures its variadic tail into a boxed CVargEntry[], and crosses with
+    // argblock=named, varargs=boxes. printf/scanf family -> the BUILT-IN
+    // echo_varg_extract; otherwise the user's registered capture op
+    // (__echo_vaops_<neutral>.capture, a WEAK reference that aborts if crossed
+    // without one). A `...` function va_start's its own list; a va_list function
+    // walks the trailing va_list parameter directly.
+    if (F->isVarArg() || shouldVaListThunk(*F)) {
+      bool Valist = !F->isVarArg();
+      EchoVaFmt VF = echoPrintfFamily(*F);
+      unsigned N = F->arg_size();
+      unsigned NFixed = Valist ? N - 1 : N; // va_list: exclude the trailing list
+      F->deleteBody();
+      F->setLinkage(GlobalValue::ExternalLinkage);
+      IRBuilder<> B(BasicBlock::Create(C, "entry", F));
+      bool IsVoid = F->getReturnType()->isVoidTy();
+      Type *I32Ty = Type::getInt32Ty(C);
+
+      // named: a natural struct of the fixed params.
+      SmallVector<Type *, 8> NamedFields;
+      for (unsigned I = 0; I < NFixed; ++I)
+        NamedFields.push_back(F->getArg(I)->getType());
+      StructType *NamedTy = StructType::get(C, NamedFields);
+      Value *Named = B.CreateAlloca(NamedTy);
+      cast<AllocaInst>(Named)->setAlignment(Align(EchoSlot));
+      for (unsigned I = 0; I < NFixed; ++I)
+        B.CreateStore(F->getArg(I), B.CreateStructGEP(NamedTy, Named, I));
+
+      // ap: `...` -> va_start a local __va_list_tag[1]; va_list -> the parameter.
+      Value *Ap;
+      FunctionCallee VaEnd;
+      if (Valist) {
+        Ap = F->getArg(N - 1);
+      } else {
+        FunctionCallee VaStart = M.getOrInsertFunction(
+            "llvm.va_start", FunctionType::get(VoidTy, {PtrTy}, false));
+        VaEnd = M.getOrInsertFunction(
+            "llvm.va_end", FunctionType::get(VoidTy, {PtrTy}, false));
+        Ap = B.CreateAlloca(ArrayType::get(I8Ty, 24));
+        cast<AllocaInst>(Ap)->setAlignment(Align(EchoSlot));
+        B.CreateCall(VaStart, {Ap});
+      }
+
+      // cvbuf + capture: built-in echo_varg_extract, else the user's capture op.
+      Value *Cv = B.CreateAlloca(ArrayType::get(I8Ty, EchoVargMax * EchoCVargSize));
+      cast<AllocaInst>(Cv)->setAlignment(Align(EchoSlot));
+      Value *Captured;
+      if (VF.Match) {
+        FunctionCallee Extract = M.getOrInsertFunction(
+            "echo_varg_extract",
+            FunctionType::get(
+                I32Ty, {I32Ty, PtrTy, PtrTy, PtrTy, I32Ty}, false));
+        Captured = B.CreateCall(
+            Extract, {B.getInt32(VF.Style), F->getArg(VF.FmtIdx), Ap, Cv,
+                      B.getInt32(EchoVargMax)});
+      } else {
+        StructType *OpsTy = StructType::get(C, {PtrTy, PtrTy});
+        Constant *Ops = echoVaopsRef(M, echoNeutralName(*F), OpsTy);
+        echoVaopsGuard(M, B, Ops, F, F->getName());
+        Value *Cap = B.CreateLoad(
+            PtrTy,
+            B.CreateInBoundsGEP(OpsTy, Ops, {B.getInt64(0), B.getInt32(0)}));
+        FunctionType *CapTy =
+            FunctionType::get(I32Ty, {PtrTy, PtrTy, PtrTy}, false);
+        Captured = B.CreateCall(CapTy, Cap, {Named, Ap, Cv});
+      }
+      if (!Valist)
+        B.CreateCall(VaEnd, {Ap});
+
+      // A capture must reject a tail that cannot fit together with its sentinel.
+      // Continuing would either replay a truncated call or consume an unterminated
+      // buffer. Custom ECHO_VAOPS capture functions use the same negative convention.
+      BasicBlock *CaptureOk = BasicBlock::Create(C, "echo.va.capture.ok", F);
+      BasicBlock *CaptureOverflow =
+          BasicBlock::Create(C, "echo.va.capture.overflow", F);
+      B.CreateCondBr(B.CreateICmpSLT(Captured, B.getInt32(0)), CaptureOverflow,
+                     CaptureOk);
+      B.SetInsertPoint(CaptureOverflow);
+      FunctionCallee Overflow = M.getOrInsertFunction(
+          "echo_varg_overflow", FunctionType::get(VoidTy, {}, false));
+      B.CreateCall(Overflow);
+      B.CreateUnreachable();
+      B.SetInsertPoint(CaptureOk);
+
+      // blk: native_target/entry_thunk from echo_bind[Idx]; argblock=named;
+      // ret=&retbuf; varargs=cvbuf.
+      Value *Blk = B.CreateAlloca(ArrayType::get(I8Ty, EchoBlockSize));
+      cast<AllocaInst>(Blk)->setAlignment(Align(EchoSlot));
+      B.CreateMemSet(Blk, B.getInt8(0), B.getInt64(EchoBlockSize),
+                     Align(EchoSlot));
+      auto VblkField = [&](uint64_t Off) {
+        return B.CreateGEP(I8Ty, Blk, {B.getInt64(Off)});
+      };
+      B.CreateAlignedStore(B.CreateLoad(PtrTy, bindFieldPtr(B, Idx, 0)),
+                           VblkField(EchoNativeTargetOff), Align(EchoSlot));
+      B.CreateAlignedStore(B.CreateLoad(PtrTy, bindFieldPtr(B, Idx, 1)),
+                           VblkField(EchoEntryThunkOff), Align(EchoSlot));
+      B.CreateAlignedStore(Named, VblkField(EchoArgblockOff), Align(EchoSlot));
+      Value *RetBuf = NullP;
+      if (!IsVoid)
+        RetBuf = B.CreateAlloca(F->getReturnType());
+      B.CreateAlignedStore(RetBuf, VblkField(EchoRetOff), Align(EchoSlot));
+      B.CreateAlignedStore(Cv, VblkField(EchoVarargsOff), Align(EchoSlot));
+      B.CreateCall(Cross, {B.getInt64(EchoIidCall), Blk});
+
+      if (IsVoid)
+        B.CreateRetVoid();
+      else
+        B.CreateRet(B.CreateLoad(F->getReturnType(), RetBuf));
+
+      // Give it a self-proving stub too, exactly like a non-variadic export. F now
+      // holds the capture body, so it becomes the stub's pack_target instead of the
+      // thing that carries F's name, and the name aliases to the stub.
+      //
+      // Without this, a variadic export has no canonical address: its face side is a
+      // plain function with no EchoStub magic, so it never enters the reverse-publish
+      // list and its __echo_faceaddr slot stays null. A table that holds it -- OpenSSL
+      // hands providers core_dispatch_[] with BIO_vsnprintf in it -- is then back-filled
+      // with nothing and the guest reads a NATIVE address out of it.
+      //
+      // Publishing the capture function's own address instead does not work, and the
+      // reason is the whole point of the stub: the same slot also canonicalises &F at
+      // NATIVE call sites, and a native caller reaching a bare capture function is
+      // classified as guest and reentered, where the argblock cannot carry a variadic
+      // tail (BIO_snprintf silently wrote an empty string). A real stub is what makes
+      // one address correct in both directions: the guest jumps through pack_target
+      // into the capture, and __echo_check_call reads the magic and hands a native
+      // caller the native body.
+      Constant *VTargetSlot = ConstantExpr::getInBoundsGetElementPtr(
+          BindArrTy, EchoBind,
+          ArrayRef<Constant *>{ConstantInt::get(I64Ty, 0),
+                               ConstantInt::get(I64Ty, Idx),
+                               ConstantInt::get(Type::getInt32Ty(C), 0)});
+      // The stub's own pack_target is F, so it cannot exist while F's uses are being
+      // redirected to the alias -- the redirect would rewrite the stub's initializer
+      // too and leave alias -> stub -> alias, a cycle that hangs everything that walks
+      // a constant (the IR printer, Constant::getRelocationInfo). So the stub is born
+      // with a null pack_target, the redirect runs, and only then is F written in.
+      //
+      // The redirect itself must be replaceAllUsesWith, NOT a hand-rolled walk that
+      // calls Use::set on each recorded use. F's address also sits inside CONSTANTS --
+      // echo_smo_patch_tab's descriptors, any const table that holds it -- and a
+      // Constant's operands are what it is uniqued by, so writing one in place leaves
+      // the uniquer holding a key that no longer matches its entry. The corruption
+      // surfaces far away as a garbage Type* while printing an unrelated global.
+      auto VLinkage = F->getLinkage();
+      auto VVis = F->getVisibility();
+      F->setName(Name + ".echo_orig");
+      auto *VStub = new GlobalVariable(
+          M, StubTy, /*isConstant=*/false, GlobalValue::InternalLinkage,
+          ConstantStruct::get(StubTy,
+                              {InstrInit, ConstantPointerNull::get(
+                                              cast<PointerType>(PtrTy)),
+                               VTargetSlot, Magic}),
+          "echo_stub_" + Name);
+      VStub->setSection("echo_stubs");
+      VStub->setAlignment(Align(16));
+      auto *VAlias = GlobalAlias::create(F->getValueType(), F->getAddressSpace(),
+                                         VLinkage, Name, VStub, &M);
+      VAlias->setVisibility(VVis);
+      F->replaceAllUsesWith(VAlias);
+      VStub->setInitializer(
+          ConstantStruct::get(StubTy, {InstrInit, F, VTargetSlot, Magic}));
+      // Published unconditionally, unlike the non-variadic case which waits to see the
+      // address escape in THIS module. The table that needs it is usually in another
+      // one: core_dispatch_[] is in provider_core.c, where BIO_vsnprintf is only a
+      // declaration, while the definition is in bio_print.c, which has no table. A
+      // per-module gate fires nowhere. It is safe to publish because the value is now a
+      // real stub: a native reader of the slot gets an address __echo_check_call
+      // translates back to the native body, which is what made publishing the bare
+      // capture function wrong.
+      EscapingAliases.push_back(VAlias);
+      continue;
+    }
+
+    // face_pack_<F>: same signature as F (entered via the stub's tail jmp, so it
+    // receives F's SysV args), body = pack args into EchoCallBlock + __echo_cross.
+    Function *Pack = Function::Create(F->getFunctionType(),
+                                      GlobalValue::InternalLinkage,
+                                      "face_pack_" + Name, &M);
+    Pack->setAttributes(F->getAttributes());
+
+    IRBuilder<> B(BasicBlock::Create(C, "entry", Pack));
+    bool IsVoid = Pack->getReturnType()->isVoidTy();
+
+    // argblock: each argument at its laid-out offset (01-abi-spec §3). A byval(T)
+    // parameter copies the pointed-to aggregate inline; every other parameter
+    // stores its value. Layout matches the native thunk's echoArgLayout.
+    const DataLayout &DL = M.getDataLayout();
+    SmallVector<EchoSlotInfo, 8> Slots;
+    uint64_t ArgbufSize = echoArgLayout(*Pack, DL, Slots);
+    Value *Argbuf = NullP;
+    if (ArgbufSize) {
+      Argbuf = B.CreateAlloca(ArrayType::get(I8Ty, ArgbufSize));
+      cast<AllocaInst>(Argbuf)->setAlignment(Align(16));
+      unsigned I = 0;
+      for (Argument &A : Pack->args()) {
+        const EchoSlotInfo &S = Slots[I++];
+        Value *Slot = B.CreateGEP(I8Ty, Argbuf, {B.getInt64(S.Off)});
+        if (S.ByvalTy)
+          B.CreateMemCpy(Slot, Align(8), &A, A.getParamAlign().valueOrOne(),
+                         B.getInt64(S.Size));
+        else
+          B.CreateAlignedStore(&A, Slot, Align(8));
+      }
+    }
+
+    Value *RetSlot = NullP;
+    if (!IsVoid)
+      RetSlot = B.CreateAlloca(Pack->getReturnType());
+
+    // C-3 (docs/20 §7): a throwing function gets an EchoException slot wired into
+    // blk.eptr; after the cross we rethrow a guest exception if status is pending.
+    bool MayThrow = !F->doesNotThrow();
+    Value *ExcSlot = NullP;
+    if (MayThrow) {
+      ExcSlot = B.CreateAlloca(ArrayType::get(I8Ty, EchoExceptionSize));
+      cast<AllocaInst>(ExcSlot)->setAlignment(Align(EchoSlot));
+      B.CreateMemSet(ExcSlot, B.getInt8(0), B.getInt64(EchoExceptionSize),
+                     Align(EchoSlot));
+      Pack->setUWTableKind(UWTableKind::Default);
+    }
+
+    Value *Blk = B.CreateAlloca(ArrayType::get(I8Ty, EchoBlockSize));
+    cast<AllocaInst>(Blk)->setAlignment(Align(EchoSlot));
+    B.CreateMemSet(Blk, B.getInt8(0), B.getInt64(EchoBlockSize), Align(EchoSlot));
+
+    auto blkField = [&](uint64_t Off) {
+      return B.CreateGEP(I8Ty, Blk, {B.getInt64(Off)});
+    };
+    B.CreateAlignedStore(B.CreateLoad(PtrTy, bindFieldPtr(B, Idx, 0)),
+                         blkField(EchoNativeTargetOff), Align(EchoSlot));
+    B.CreateAlignedStore(B.CreateLoad(PtrTy, bindFieldPtr(B, Idx, 1)),
+                         blkField(EchoEntryThunkOff), Align(EchoSlot));
+    B.CreateAlignedStore(Argbuf, blkField(EchoArgblockOff), Align(EchoSlot));
+    B.CreateAlignedStore(RetSlot, blkField(EchoRetOff), Align(EchoSlot));
+    if (MayThrow)
+      B.CreateAlignedStore(ExcSlot, blkField(EchoEptrOff), Align(EchoSlot));
+    B.CreateCall(Cross, {B.getInt64(EchoIidCall), Blk});
+
+    if (MayThrow) {
+      Value *Status = B.CreateAlignedLoad(Type::getInt32Ty(C),
+                                          blkField(EchoStatusOff), Align(4));
+      Value *Pend = B.CreateICmpEQ(Status, B.getInt32(EchoStatusPending));
+      BasicBlock *Rethrow = BasicBlock::Create(C, "rethrow", Pack);
+      BasicBlock *OkBB = BasicBlock::Create(C, "ok", Pack);
+      B.CreateCondBr(Pend, Rethrow, OkBB);
+      IRBuilder<> RB(Rethrow);
+      RB.CreateCall(M.getOrInsertFunction(
+                        "__echo_rethrow",
+                        FunctionType::get(Type::getVoidTy(C), {PtrTy}, false)),
+                    {ExcSlot});
+      RB.CreateUnreachable();
+      B.SetInsertPoint(OkBB);
+    }
+
+    if (IsVoid)
+      B.CreateRetVoid();
+    else
+      B.CreateRet(B.CreateLoad(Pack->getReturnType(), RetSlot));
+
+    // target_slot -> &echo_bind[Idx].native_target (link-time); *target_slot is
+    // the real native body (handshake-filled), read by host __echo_check_call.
+    Constant *TargetSlot = ConstantExpr::getInBoundsGetElementPtr(
+        BindArrTy, EchoBind,
+        ArrayRef<Constant *>{ConstantInt::get(I64Ty, 0),
+                             ConstantInt::get(I64Ty, Idx),
+                             ConstantInt::get(Type::getInt32Ty(C), 0)});
+
+    // EchoStub global in the (page-aligned + mprotect'd) echo_stubs section.
+    Constant *Init =
+        ConstantStruct::get(StubTy, {InstrInit, Pack, TargetSlot, Magic});
+    auto *Stub = new GlobalVariable(M, StubTy, /*isConstant=*/false,
+                                    GlobalValue::InternalLinkage, Init,
+                                    "echo_stub_" + Name);
+    Stub->setSection("echo_stubs");
+    Stub->setAlignment(Align(16));
+
+    // Alias F's original name to the stub start: &F / vtable slots / guest direct
+    // calls all resolve to the self-stub (docs/05 §3 "规范地址即 stub").
+    F->setName(Name + ".echo_orig");
+    auto *Alias = GlobalAlias::create(F->getValueType(), F->getAddressSpace(),
+                                      F->getLinkage(), Name, Stub, &M);
+    Alias->setVisibility(F->getVisibility());
+    if (EscapingNames.count(Name))
+      EscapingAliases.push_back(Alias); // canonical face address of F = its stub
+    F->replaceAllUsesWith(Alias);
+    F->eraseFromParent();
+  }
+
+  // Per-module resolver: fills this module's echo_bind by crossing to the native
+  // __echo_publish_<hash> (docs/19 §6b). It is INTERNAL and registered in the
+  // linker-collected `echo_resolvers` section, so a multi-.cpp library links
+  // without colliding and the bootstrap runs every module's resolver (like the
+  // echo_stubs section). The publish symbol name is passed so the runtime resolves
+  // this module's matching native publisher.
+  Type *I32Ty = Type::getInt32Ty(C);
+  FunctionCallee Publish = M.getOrInsertFunction(
+      "__echo_bind_via_publish",
+      FunctionType::get(VoidTy, {PtrTy, PtrTy, I32Ty, I64Ty, PtrTy, PtrTy}, false));
+  Function *Resolve = Function::Create(
+      FunctionType::get(VoidTy, {PtrTy}, false), GlobalValue::InternalLinkage,
+      "echo_gen_resolve", &M);
+  {
+    IRBuilder<> B(BasicBlock::Create(C, "entry", Resolve));
+    // The publish symbol is keyed by the arch-invariant SOURCE hash so the face
+    // resolves this module's native publisher even when arch-#ifdef code makes the
+    // two worklists differ; Ver (the worklist hash) rides along as a soft check, and
+    // echo_bindnames drives the name-based fill.
+    Constant *PubNameC = B.CreateGlobalString(
+        ("__echo_publish_" + Twine::utohexstr(echoSourceHash(M))).str());
+    B.CreateCall(Publish, {Resolve->getArg(0), EchoBind, B.getInt32(NumStubs),
+                           B.getInt64(Ver), PubNameC, EchoBindNames});
+
+    // Reverse-publish each face vtable's address points (docs/20 §6 / Stage C
+    // C-1): emit a {slot-name, &vtable+byteoff} table and hand it to
+    // __echo_publish_facevts, which fills the native __echo_facevt$<vtable>$<off>
+    // slots the constructors load.
+    //
+    // A class's _ZTV is a struct with ONE array per vtable component: the primary
+    // vtable plus one secondary vtable per non-primary base (multiple inheritance),
+    // and one per virtual base. A component is
+    //   [vcall offsets...][vbase offsets...] offset_to_top typeinfo [vfns...]
+    // and its ADDRESS POINT is the entry right after typeinfo. The leading
+    // vcall/vbase-offset run is empty for non-virtual bases but nonzero under
+    // virtual inheritance, so we locate the address point by finding the typeinfo
+    // entry (the component's `_ZTI...` pointer) rather than assuming a fixed +2.
+    // Every component's address point is published keyed by its byte offset within
+    // _ZTV, matching CGClass.cpp's load side, so each subobject vptr (including a
+    // shared virtual base's) binds to its own face vtable.
+    uint64_t PtrSize = M.getDataLayout().getPointerSize();
+    StructType *EntryTy = StructType::get(C, {PtrTy, PtrTy});
+    SmallVector<Constant *, 8> Entries;
+    for (GlobalVariable &G : M.globals()) {
+      if (!G.getName().starts_with("_ZTV") || !G.hasInitializer())
+        continue;
+      auto *ST = dyn_cast<ConstantStruct>(G.getInitializer());
+      if (!ST)
+        continue;
+      uint64_t CumEntries = 0;
+      for (unsigned Ci = 0, NComp = ST->getNumOperands(); Ci < NComp; ++Ci) {
+        auto *CA = dyn_cast<ConstantArray>(ST->getOperand(Ci));
+        unsigned NElem = CA ? CA->getNumOperands() : 0;
+        // Address point = entry after this component's typeinfo pointer.
+        unsigned APIdx = 2; // fallback: [offset_to_top, typeinfo] then addr point
+        for (unsigned E = 0; E < NElem; ++E) {
+          Value *V = CA->getOperand(E)->stripPointerCasts();
+          if (auto *GV = dyn_cast<GlobalValue>(V))
+            if (GV->getName().starts_with("_ZTI")) {
+              APIdx = E + 1;
+              break;
+            }
+        }
+        uint64_t ByteOff = (CumEntries + APIdx) * PtrSize;
+        Constant *NamePtr = B.CreateGlobalString(
+            ("__echo_facevt$" + G.getName() + "$" + Twine(ByteOff)).str());
+        Constant *AP = ConstantExpr::getInBoundsGetElementPtr(
+            I8Ty, &G, ArrayRef<Constant *>{ConstantInt::get(I64Ty, ByteOff)});
+        Entries.push_back(ConstantStruct::get(EntryTy, {NamePtr, AP}));
+        CumEntries += NElem;
+      }
+    }
+    // R-2: publish each guest redispatcher into the native __echo_redisp$<key>
+    // slot (same name->ptr channel as the facevt slots). The key is recovered
+    // from the redispatcher's name suffix (echo_redispatch_<key>).
+    for (Function *RD : Redispatchers) {
+      StringRef Key = RD->getName().drop_front(StringRef("echo_redispatch_").size());
+      Constant *NamePtr =
+          B.CreateGlobalString(("__echo_redisp$" + Key).str());
+      Entries.push_back(ConstantStruct::get(EntryTy, {NamePtr, RD}));
+    }
+    // Canonical face address: fill each native __echo_faceaddr$F slot with this
+    // face's stub for F (the alias carries F's original name and points at the
+    // stub), so a demoted function pointer compares equal across the world boundary.
+    for (GlobalAlias *A : EscapingAliases) {
+      // The slot name must be the one the native half emitted, which for an internal
+      // function carries the module hash (echoFaceAddrSlotName). The alias keeps F's
+      // original name, so look the slot up by that.
+      auto It = EscapingSlot.find(A->getName());
+      std::string SlotName = It != EscapingSlot.end()
+                                 ? It->second
+                                 : ("__echo_faceaddr$" + A->getName()).str();
+      Constant *NamePtr = B.CreateGlobalString(SlotName);
+      Entries.push_back(ConstantStruct::get(EntryTy, {NamePtr, A}));
+    }
+    // Canonical data storage/address: fill each native __echo_var$G slot with this
+    // face's copy of the global. A const global (identical bytes) is address-only
+    // (size 0). A mutable global carries its byte size, so the host also copies the
+    // native copy's current (static-init) value into this face copy at publish.
+    for (GlobalVariable *G : SyncVars) {
+      Constant *NamePtr =
+          B.CreateGlobalString(("__echo_var$" + G->getName()).str());
+      Entries.push_back(ConstantStruct::get(EntryTy, {NamePtr, G}));
+    }
+    if (!Entries.empty()) {
+      Constant *PubInit =
+          ConstantArray::get(ArrayType::get(EntryTy, Entries.size()), Entries);
+      auto *PubTab = new GlobalVariable(M, PubInit->getType(), /*isConstant=*/true,
+                                        GlobalValue::InternalLinkage, PubInit,
+                                        "echo_facevt_pub");
+      FunctionCallee PubVt = M.getOrInsertFunction(
+          "__echo_publish_facevts",
+          FunctionType::get(VoidTy, {PtrTy, PtrTy, I32Ty}, false));
+      B.CreateCall(PubVt,
+                   {Resolve->getArg(0), PubTab, B.getInt32(Entries.size())});
+    }
+    B.CreateRetVoid();
+  }
+
+  // Register the resolver in the linker-collected `echo_resolvers` section; the
+  // bootstrap iterates __start_/__stop_echo_resolvers and calls each module's.
+  auto *ResolverPtr =
+      new GlobalVariable(M, PtrTy, /*isConstant=*/true,
+                         GlobalValue::InternalLinkage, Resolve, "echo_resolver_ptr");
+  ResolverPtr->setSection("echo_resolvers");
+  appendToUsed(M, {ResolverPtr});
+
+  // Last: the library's static initialisers belong to the native half alone. Runs after
+  // Echo has appended its own constructors above, which this keeps.
+  echoStripFaceSourceCtors(M);
+
+  return true;
+}
+
+
+#endif // LLVM_LIB_TARGET_ECHOCALLLOWERINGIMPL_H
