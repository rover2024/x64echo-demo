+// x64echo (01-abi-spec §7, Tier-2 faithful exceptions): at a throw site, emit a
+// descriptor  __echo_exc$<type_info::name()> = { i64 size, ptr type_info,
+// ptr copy-ctor, ptr dtor }  for the thrown class type. Both the native and the
+// -echo-emit-face build emit it from the library's throw sites, so the runtime
+// can, on a cross-boundary throw, copy-construct a faithful copy of the exception
+// object and rethrow it as the real type (guest `catch (Concrete&)` matches, and
+// members survive). No-op unless a copy constructor is available; otherwise the
+// type falls back to the Tier-1 message channel.
+static void emitEchoExcDescriptor(CodeGenModule &CGM, QualType ThrowType) {
+  if (CGM.getTriple().getEnvironment() != llvm::Triple::Echo)
+    return;
+  QualType T = ThrowType.getNonReferenceType().getUnqualifiedType();
+  const CXXRecordDecl *RD = T->getAsCXXRecordDecl();
+  if (!RD || !RD->hasDefinition())
+    return;
+  // std:: exception types are handled by the Tier-1 message channel; emitting a
+  // descriptor for them would reference libstdc++'s copy-ctor (not linkable
+  // here). Only library-defined types get the faithful Tier-2 path.
+  if (RD->isInStdNamespace())
+    return;
+
+  SmallString<256> RTTIName;
+  {
+    llvm::raw_svector_ostream Out(RTTIName);
+    CGM.getCXXABI().getMangleContext().mangleCXXRTTIName(T, Out);
+  }
+  StringRef TiName = RTTIName;
+  TiName.consume_front("_ZTS"); // type_info::name() is the _ZTS body
+  std::string GName = ("__echo_exc$" + TiName).str();
+  llvm::Module &M = CGM.getModule();
+  if (M.getNamedValue(GName))
+    return;
+
+  const CXXConstructorDecl *Copy = nullptr;
+  for (const CXXConstructorDecl *Ctor : RD->ctors())
+    if (Ctor->isCopyConstructor() && !Ctor->isDeleted()) {
+      Copy = Ctor;
+      break;
+    }
+  const CXXDestructorDecl *Dtor = RD->getDestructor();
+  if (!Copy || !Dtor || Dtor->isDeleted())
+    return; // no usable copy-ctor/dtor -> Tier-1 fallback for this type
+
+  // NB: a `throw T()` prvalue is constructed directly in the exception object (guaranteed
+  // copy elision), so the copy-ctor is not ODR-used by the throw. Sema force-references it
+  // in the Echo environment (BuildCXXThrow) so it is defined and emitted here; otherwise a
+  // defaulted copy-ctor would be a null weak ref and Tier-2 would degrade to Tier-1.
+  llvm::Constant *CopyFn =
+      CGM.getAddrOfCXXStructor(GlobalDecl(Copy, Ctor_Complete));
+  llvm::Constant *DtorFn =
+      CGM.getAddrOfCXXStructor(GlobalDecl(Dtor, Dtor_Complete));
+  // If a structor is only a declaration here (a user-declared copy-ctor defined
+  // in another TU that may never be emitted, e.g. jsoncpp's Json::LogicError),
+  // reference it weakly so it does not become an undefined reference: if some TU
+  // in the library defines it, the weak ref resolves and Tier-2 works; otherwise
+  // it is null and the runtime falls back to the Tier-1 message channel.
+  auto weakenIfDecl = [](llvm::Constant *C) {
+    if (auto *F = llvm::dyn_cast<llvm::Function>(C))
+      if (F->isDeclaration())
+        F->setLinkage(llvm::GlobalValue::ExternalWeakLinkage);
+  };
+  weakenIfDecl(CopyFn);
+  weakenIfDecl(DtorFn);
+  llvm::Constant *Ti = CGM.GetAddrOfRTTIDescriptor(T, /*ForEH=*/true);
+  uint64_t Size = CGM.getContext().getTypeSizeInChars(T).getQuantity();
+
+  llvm::LLVMContext &Ctx = CGM.getLLVMContext();
+  llvm::Type *PtrTy = llvm::PointerType::getUnqual(Ctx);
+  llvm::Type *I64Ty = llvm::Type::getInt64Ty(Ctx);
+  llvm::StructType *DescTy =
+      llvm::StructType::get(Ctx, {I64Ty, PtrTy, PtrTy, PtrTy});
+  llvm::Constant *Init = llvm::ConstantStruct::get(
+      DescTy, {llvm::ConstantInt::get(I64Ty, Size), Ti, CopyFn, DtorFn});
+  auto *GV = new llvm::GlobalVariable(M, DescTy, /*isConstant=*/true,
+                                      llvm::GlobalValue::LinkOnceODRLinkage, Init,
+                                      GName);
+  GV->setVisibility(llvm::GlobalValue::DefaultVisibility);
+  CGM.addUsedGlobal(GV);
+}
