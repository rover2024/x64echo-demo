diff --git a/llvm/lib/Target/X86/X86EchoCallLowering.cpp b/llvm/lib/Target/X86/X86EchoCallLowering.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..be3191b4cf808b48ee69aebcbef22edd786601f8
--- /dev/null
+++ b/llvm/lib/Target/X86/X86EchoCallLowering.cpp
@@ -0,0 +1,47 @@
+//===- X86EchoCallLowering.cpp - Echo ABI call lowering (X86) --------------===//
+//
+// Part of the LLVM Project (x64echo).
+//
+//===----------------------------------------------------------------------===//
+//
+// Thin X86 entry point for the shared Echo ABI call-lowering pass. All the logic
+// lives in EchoCallLoweringImpl.h (target-independent); this file only supplies the
+// pass boilerplate and the -echo-emit-face flag. The face (guest-side) half is
+// selected here because it is always x86. See x64echo docs/19 §6a.
+//
+//===----------------------------------------------------------------------===//
+
+#include "X86.h"
+#include "../EchoCallLoweringImpl.h"
+#include "llvm/Pass.h"
+#include "llvm/Support/CommandLine.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "x86-echo-call-lowering"
+
+// Select the face half (pack+cross stubs) instead of the default native half
+// (entry thunks). Passed via `clang -mllvm -echo-emit-face`; see docs/19 §6a.
+static cl::opt<bool>
+    EchoEmitFace("echo-emit-face", cl::Hidden, cl::init(false),
+                 cl::desc("x64echo: emit the face (guest-side) stubs instead of "
+                          "the native entry thunks"));
+
+namespace {
+class X86EchoCallLowering : public ModulePass {
+public:
+  static char ID;
+  X86EchoCallLowering() : ModulePass(ID) {}
+  bool runOnModule(Module &M) override { return echoRunOnModule(M, EchoEmitFace); }
+  StringRef getPassName() const override { return "X86 Echo call lowering"; }
+};
+} // end anonymous namespace
+
+char X86EchoCallLowering::ID = 0;
+
+INITIALIZE_PASS(X86EchoCallLowering, DEBUG_TYPE, "X86 Echo call lowering", false,
+                false)
+
+ModulePass *llvm::createX86EchoCallLoweringPass() {
+  return new X86EchoCallLowering();
+}
