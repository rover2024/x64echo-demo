diff --git a/llvm/lib/Target/RISCV/RISCVEchoCallLowering.cpp b/llvm/lib/Target/RISCV/RISCVEchoCallLowering.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90f6606949cfb6c2eeaaf46675fa6c1e9cfa33a1
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVEchoCallLowering.cpp
@@ -0,0 +1,49 @@
+//===- RISCVEchoCallLowering.cpp - Echo ABI call lowering (RISC-V) ---------===//
+//
+// Part of the LLVM Project (x64echo).
+//
+//===----------------------------------------------------------------------===//
+//
+// Thin RISC-V entry point for the shared Echo ABI call-lowering pass. All the
+// logic lives in EchoCallLoweringImpl.h (target-independent); this file only
+// supplies the pass boilerplate. Only the native (host) half is emitted here --
+// the face is always x86_64, so EmitFace is false, exactly as on AArch64.
+//
+// Nothing about the pass is RISC-V specific. What the two halves have to agree on
+// is the SOURCE-level signature, not the machine one: the block layout, the
+// dispatcher keying and the publish worklist are all derived from LLVM IR types
+// and from mangled names, and the one place where the machine ABI leaks into a
+// name -- the spelling of va_list -- is canonicalised in echoNeutralName, which
+// now knows RISC-V's spelling too (it is a plain void*, so it is recognised by the
+// front-end's "echo-valist" tag rather than by the mangling).
+//
+//===----------------------------------------------------------------------===//
+
+#include "RISCV.h"
+#include "../EchoCallLoweringImpl.h"
+#include "llvm/Pass.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "riscv-echo-call-lowering"
+
+namespace {
+class RISCVEchoCallLowering : public ModulePass {
+public:
+  static char ID;
+  RISCVEchoCallLowering() : ModulePass(ID) {}
+  bool runOnModule(Module &M) override {
+    return echoRunOnModule(M, /*EmitFace=*/false);
+  }
+  StringRef getPassName() const override { return "RISC-V Echo call lowering"; }
+};
+} // end anonymous namespace
+
+char RISCVEchoCallLowering::ID = 0;
+
+INITIALIZE_PASS(RISCVEchoCallLowering, DEBUG_TYPE, "RISC-V Echo call lowering",
+                false, false)
+
+ModulePass *llvm::createRISCVEchoCallLoweringPass() {
+  return new RISCVEchoCallLowering();
+}
