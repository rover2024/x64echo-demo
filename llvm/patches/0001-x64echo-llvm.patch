+//===- EchoCallLoweringImpl.h - Shared Echo ABI call lowering ---*- C++ -*-===//
+//
+// Part of the LLVM Project (x64echo). Shared implementation of the Echo ABI
+// call-lowering pass, #included by the thin per-target passes
+// (X86EchoCallLowering.cpp, AArch64EchoCallLowering.cpp) so the logic lives once.
+// All functions have internal linkage.
+//
+//===----------------------------------------------------------------------===//
+#ifndef LLVM_LIB_TARGET_ECHOCALLLOWERINGIMPL_H
+#define LLVM_LIB_TARGET_ECHOCALLLOWERINGIMPL_H
+
+//===- X86EchoCallLowering.cpp - Emit Echo entry thunks -------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// For the x64echo ABI (triple environment "echo"), the native library that a
+// QEMU linux-user guest reaches must expose, per exported function F, an entry
+// thunk that the cross-boundary runtime invokes:
+//
+//   void thunk_F(EchoCallBlock *b);
+//
+// which unpacks F's arguments from the block's flat argblock (8-byte slots; see
+// x64echo docs/10) and writes F's result into the block's ret pointer. This is
+// what the prototype's facegen emitted as host_thunks.c; here the compiler emits
+// it directly. B-1 handles the leaf, <=8-byte-per-value case.
+//
+// B-2 adds the matching *face* side, selected by -echo-emit-face (passed via
+// clang -mllvm). In face mode the same parse is codegen'd a second time, but the
+// pass REPLACES each exported body with its pack+cross stub (the symbol keeps
+// clang's already-mangled name) and synthesizes echo_bind + __echo_gen_resolve.
+// native.o (default) and face.o (-echo-emit-face) become the two-file pair; this
+// retires the prototype's facegen entirely (face_stubs.c / face_resolve.c). See
+// x64echo docs/19 §6a.
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/IR/Attributes.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DerivedTypes.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/GlobalAlias.h"
+#include "llvm/IR/GlobalVariable.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/StringSet.h"
+#include "llvm/IR/IntrinsicInst.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Metadata.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Pass.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/TargetParser/Triple.h"
+#include "llvm/Transforms/Utils/ModuleUtils.h"
+
+using namespace llvm;
+
+// EchoCallBlock field byte offsets (x86_64; see x64echo runtime/echo_call.h):
+//   void *native_target;  // 0
+//   void *entry_thunk;    // 8
+//   void *argblock;       // 16
+//   void *ret;            // 24
+//   ... (status/reentry/eptr/varargs)        total size 64
+static constexpr uint64_t EchoNativeTargetOff = 0;
+static constexpr uint64_t EchoEntryThunkOff = 8;
+static constexpr uint64_t EchoArgblockOff = 16;
+static constexpr uint64_t EchoRetOff = 24;
+static constexpr uint64_t EchoBlockSize = 64;
+static constexpr uint64_t EchoSlot = 8;
+
+// EchoBinding { native_target; entry_thunk; } and EchoPublish field offsets
+// (echo_call.h; used by the B-3a publish handshake, docs/19 §6b).
+static constexpr uint64_t EchoBindingSize = 16;
+static constexpr uint64_t EchoPublishTableOff = 0;
+static constexpr uint64_t EchoPublishCountOff = 8;
+static constexpr uint64_t EchoPublishVersionOff = 16;
+static constexpr uint64_t EchoPublishNamesOff = 24;
+// EchoNatDirEntry { const char *name; native_target; thunk; } — a native module's
+// name-keyed directory for the B-3a name-based binding handshake.
+static constexpr uint64_t EchoNatDirEntrySize = 24;
+static constexpr uint64_t EchoNatDirNameOff = 0;
+static constexpr uint64_t EchoNatDirTargetOff = 8;
+static constexpr uint64_t EchoNatDirThunkOff = 16;
+
+// EchoInvocationId::ECHO_IID_CALL (echo_call.h).
+static constexpr uint64_t EchoIidCall = 0;
+
+// EchoReentry { guest_fn; dispatcher; argblock; ret; varargs; } byte offsets and
+// EchoStatus::ECHO_NEED_REENTRY=1 (echo_call.h). For the host->guest reenter path
+// (docs/23 §2). The native dispatcher builds one on its stack.
+static constexpr uint64_t EchoReGuestFnOff = 0;
+static constexpr uint64_t EchoReDispatcherOff = 8;
+static constexpr uint64_t EchoReArgblockOff = 16;
+static constexpr uint64_t EchoReRetOff = 24;
+static constexpr uint64_t EchoReVarargsOff = 32;
+static constexpr uint64_t EchoReentrySize = 40;
+
+// EchoCallBlock status@32 / eptr@48; EchoStatus::ECHO_PENDING_EXCEPTION=2;
