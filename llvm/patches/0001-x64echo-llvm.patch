+// x64echo: some polymorphic types are host-internal machinery that libstdc++ (or
+// another uninstrumented runtime) dispatches on DIRECTLY -- e.g. a std::locale facet
+// virtual-deleted during std::locale teardown. C-1-redirecting such a vptr to the
+// face vtable makes that host-side virtual dispatch cross to the guest from host
+// context and crash; these must keep their native vtable in both worlds.
+//
+// The COMPILER keeps only the generic mechanism: a class is excluded iff it is, or
+// derives from, one of a set of base classes given by QUALIFIED NAME. The concrete
+// list is DATA owned by the build, NOT policy baked into the compiler -- it is read
+// from the file named by ECHO_NOREDIRECT_FILE (one qualified base name per line, '#'
+// comments) and/or the ':'-separated ECHO_NOREDIRECT_BASES. Adding a type (say
+// std::__shared_count's counted base) needs no clang rebuild, just a line of data.
+namespace {
+struct EchoNoRedirectEntry {
+  std::string Full;   // e.g. "std::locale::facet"
+  std::string Simple; // last "::" component, for a cheap pre-filter
+  bool Bare;          // entry had no "::" -> match by simple name alone (handles
+                      // anonymous-namespace / per-TU internal types like Qt's
+                      // (anonymous namespace)::QResourceRoot, whose qualified name
+                      // is unstable, and unique enough that the leaf name suffices)
+};
+} // namespace
+static const std::vector<EchoNoRedirectEntry> &echoNoRedirectBases() {
+  static const std::vector<EchoNoRedirectEntry> Bases = [] {
+    std::vector<EchoNoRedirectEntry> V;
+    auto add = [&](llvm::StringRef S) {
+      S = S.trim();
+      if (S.empty() || S.starts_with("#"))
+        return;
+      llvm::StringRef Simple = S;
+      size_t Pos = S.rfind("::");
+      bool Bare = Pos == llvm::StringRef::npos;
+      if (!Bare)
+        Simple = S.drop_front(Pos + 2);
+      V.push_back({S.str(), Simple.str(), Bare});
+    };
+    if (const char *File = std::getenv("ECHO_NOREDIRECT_FILE"))
+      if (auto Buf = llvm::MemoryBuffer::getFile(File)) {
+        llvm::SmallVector<llvm::StringRef, 16> Lines;
+        (*Buf)->getBuffer().split(Lines, '\n');
+        for (llvm::StringRef L : Lines)
+          add(L);
+      }
+    if (const char *Inline = std::getenv("ECHO_NOREDIRECT_BASES")) {
+      llvm::SmallVector<llvm::StringRef, 16> Parts;
+      llvm::StringRef(Inline).split(Parts, ':');
+      for (llvm::StringRef P : Parts)
+        add(P);
+    }
+    return V;
+  }();
+  return Bases;
+}
+static bool echoIsNoRedirectClass(const CXXRecordDecl *RD) {
+  const std::vector<EchoNoRedirectEntry> &Bases = echoNoRedirectBases();
+  if (Bases.empty() || !RD || !RD->isCompleteDefinition())
+    return false;
+  auto matches = [&](const CXXRecordDecl *C) {
+    if (!C || !C->getIdentifier())
+      return false;
+    llvm::StringRef SN = C->getName();
+    for (const EchoNoRedirectEntry &E : Bases)
+      if (SN == E.Simple && (E.Bare || C->getQualifiedNameAsString() == E.Full))
+        return true;
+    return false;
+  };
+  if (matches(RD))
+    return true;
+  bool Found = false;
+  RD->forallBases([&](const CXXRecordDecl *Base) {
+    if (matches(Base)) {
+      Found = true;
+      return false; // short-circuit
+    }
+    return true;
+  });
+  return Found;
+}
