--- a/llvm/lib/Target/RISCV/RISCVTargetMachine.cpp
+++ b/llvm/lib/Target/RISCV/RISCVTargetMachine.cpp
@@ -133,6 +133,7 @@ extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void LLVMInitializeRISCVTarget() {
   initializeRISCVMakeCompressibleOptPass(*PR);
   initializeRISCVGatherScatterLoweringPass(*PR);
   initializeRISCVCodeGenPreparePass(*PR);
+  initializeRISCVEchoCallLoweringPass(*PR);
   initializeRISCVPostRAExpandPseudoPass(*PR);
   initializeRISCVMergeBaseOffsetOptPass(*PR);
   initializeRISCVOptWInstrsPass(*PR);
@@ -468,6 +469,13 @@ bool RISCVPassConfig::addRegAssignAndRewriteOptimized() {
 }
 
 void RISCVPassConfig::addIRPasses() {
+  // x64echo: emit native Echo entry thunks when the host arch is riscv64 (the
+  // x86_64 guest still targets the X86 pass; this is the native/host half).
+  // First in the pipeline, as on AArch64: the pass rewrites whole functions and
+  // adds new ones, so it wants the IR before anything else has specialised it.
+  if (TM->getTargetTriple().getEnvironment() == Triple::Echo)
+    addPass(createRISCVEchoCallLoweringPass());
+
   addPass(createAtomicExpandLegacyPass());
