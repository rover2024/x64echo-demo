@@ -2616,6 +2616,73 @@ void CodeGenModule::SetLLVMFunctionAttributesForDefinition(const Decl *D,
                                                            llvm::Function *F) {
   llvm::AttrBuilder B(F->getContext());
 
+  // Echo: surface a printf/scanf format attribute into the IR as "echo-format", so
+  // the Echo variadic pass can auto-adapt a printf-SHAPED function that is not
+  // printf-NAMED. e.g. QTest::addRow(const char *, ...) is annotated
+  // __attribute__((format(printf,1,2))) but has no "printf" in its name; without
+  // this it falls through to the loud abort(). Mirrors lorelei's LibCFormat, which
+  // reads clang::FormatAttr at the AST level -- our pass is IR-level, hence the tag.
+  if (getTriple().getEnvironment() == llvm::Triple::Echo) {
+    if (const auto *FD = dyn_cast_or_null<FunctionDecl>(D)) {
+      if (const auto *FA = FD->getAttr<FormatAttr>()) {
+        StringRef T = FA->getType()->getName();
+        if (T.contains("scanf"))
+          F->addFnAttr("echo-format", "scanf");
+        else if (T.contains("printf"))
+          F->addFnAttr("echo-format", "printf");
+      }
+      // Echo: surface a va_list PARAMETER into the IR as "echo-valist". The Echo
+      // variadic pass routes va_list functions through capture/replay (the guest's
+      // arch-specific va_list cannot be handed to the host verbatim). It detected them
+      // by mangled name (P13__va_list_tag / St9__va_list), which an extern "C" function
+      // lacks -- so a C va_list function silently fell through to a raw-pointer marshal
+      // that only works same-arch. The AST carries the real type regardless of linkage
+      // or opaque pointers, and getBuiltinVaListType() is consistent across the face
+      // (x86) and native (arm64) compiles, so both halves tag the same functions.
+      // Mirrors lorelei's LibCFormat (AST-level detection, IR-level tag for our pass).
+      ASTContext &Ctx = getContext();
+      QualType VaTy = Ctx.getBuiltinVaListType().getCanonicalType();
+      QualType VaElem = VaTy;
+      if (const ArrayType *AT = Ctx.getAsArrayType(VaTy))
+        VaElem = AT->getElementType(); // x86: va_list is __va_list_tag[1] -> decays
+      // Two ways to recognise the parameter, because the builtin type differs.
+      //
+      // x86-64 and AArch64 spell va_list as a record, so the canonical type alone
+      // identifies it. RISC-V spells it as a plain void*, where that test would tag
+      // every pointer parameter -- and NOT tagging it is not a safe default either:
+      // without the attribute the two halves disagree about the function's identity
+      // (the face exports ...P13__va_list_tag, the riscv64 native ...Pv), the publish
+      // handshake never matches them, the block's entry thunk stays null and the first
+      // call jumps to address zero. So on such a target, look at what the parameter was
+      // WRITTEN as: a va_list parameter is spelled through the builtin va_list typedef,
+      // and an ordinary void* is not.
+      if (VaElem->isRecordType()) {
+        for (const ParmVarDecl *P : FD->parameters()) {
+          QualType PT = P->getType().getCanonicalType();
+          QualType Cmp = PT->isPointerType() ? PT->getPointeeType() : PT;
+          if (Ctx.hasSameType(Cmp.getCanonicalType(), VaElem.getCanonicalType())) {
+            F->addFnAttr("echo-valist");
+            break;
+          }
+        }
+      } else if (const TypedefDecl *VaDecl = Ctx.getBuiltinVaListDecl()) {
+        for (const ParmVarDecl *P : FD->parameters()) {
+          for (QualType T = P->getType(); const auto *TT = T->getAs<TypedefType>();
+               T = TT->getDecl()->getUnderlyingType()) {
+            const TypedefNameDecl *TD = TT->getDecl();
+            if (TD->getCanonicalDecl() == VaDecl->getCanonicalDecl() ||
+                TD->getName() == "va_list" || TD->getName() == "__builtin_va_list") {
+              F->addFnAttr("echo-valist");
+              break;
+            }
+          }
+          if (F->hasFnAttribute("echo-valist"))
+            break;
+        }
+      }
+    }
+  }
